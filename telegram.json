u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 16 \u0440\u0430\u0441\u0447\u0451\u0442\u043e\u0432 \u2014 \u0432 \u0432\u0438\u0434\u0435\u043e\u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0435. \ud83d\udd34 \u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u00bb \ud83d\udd34 Rutube \ud83d\udc4a \u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u0430\u00bb \u043d\u0430 Lostarmour \ud83d\udd34 \u0412\u0441\u0442\u0443\u043f\u0438\u0442\u044c \u0432 \u00ab\u0420\u0443\u0431", "snippet_en": "\u0414\u043e\u043d\u0431\u0430\u0441\u0441 \u041e\u0442 \u043a\u043e\u043c\u0430\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u0433\u0440\u0430\u043d\u0430\u0442\u043e\u043c\u0451\u0442\u043d\u044b\u043c \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u2014 \u0434\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u0438\u0440\u0430 \u0438\u0441\u043f\u044b\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u0411\u043f\u041b\u0410 \u0441\u0430\u043c\u043e\u043b\u0451\u0442\u043d\u043e\u0433\u043e \u0442\u0438\u043f\u0430 \u0426\u0435\u043d\u0442\u0440\u0430 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u00bb. \u0411\u043e\u043b\u0435\u0435 2500 \u0432\u044b\u043b\u0435\u0442\u043e\u0432 \u043d\u0430 \u0441\u0447\u0435\u0442\u0443 \u0435\u0433\u043e \u0440\u0430\u0441\u0447\u0451\u0442\u0430, \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u0438 \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u044b \u0431\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u0438\u043a\u043e\u0432 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430. \u041e \u0431\u043e\u0435\u0432\u043e\u043c \u043f\u0443\u0442\u0438, \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u043d\u0430\u0433\u0440\u0430\u0434\u0430\u