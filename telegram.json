3\u043c\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 06:50 - \u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u044f 07:24 - \u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0412\u0421\u0423 08:19 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 09:22 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u043e\u0447\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 09:47 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043a\u043e\u0432 \"\u041c\u043e", "snippet_en": "\u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0437\u0430 27 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 2026 \u0433\u043e\u0434\u0430 00:05 - \u0414\u043e\u043d\u0431\u0430\u0441\u0441 05:15 - \u041a\u0440\u0430\u0441\u043d\u043e\u043b\u0438\u043c\u0430\u043d\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 06:09 - \u0421\u0443\u043c\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 06:50 - \u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u044f 07:24 - \u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0412\u0421\u0423 08:19 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 09:22 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u043e\u0447\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 09:47 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043a\u043e\u0432 \"\u041c\u043e", "link": "https://t.me/lost_armour/11968", "pubDate": "2026-10-27T10:22:11+00:00"}, {"channel": "combat_ftg2", "snippet": "Ukraine\u2019s Defense Forces have reportedly carried out the world\u2019s first aerial drone evacuation of a wounded soldier from the front line. A soldier from the 30th Mechanized Brigade was wounded at his position. Due to the high density of enemy drones and extensive mining, evacuation by ground robotic system was impossible. Fighters from the 92nd Assault Brigade\u2019s ground robotic systems company came ", "snippet_en": "Ukraine\u2019s Defense Forces have reportedly carried out the world\u2019s first aerial drone evacuation of a wounded soldier from the front line. A soldier from the 30th Mechanized Brigade was wounded at his position. Due to the high density of enemy drones and extensive mining, evacuation by ground robotic system was impossible. Fighters from the 92nd Assault Brigade\u2019s ground robotic systems company came ", "link": "https://t.me/combat_ftg2/3720", "pubDate": "2026-10-19T09:19:21+00:00"}, {"channel": "serhii_flash", "snippet": "\u041a\u043e\u043b\u0438 \u0432\u0441\u0456 \u0431\u0430\u0447\u0430\u0442\u044c \u0432\u0456\u0437\u0443\u0430\u043b\u044c\u043d\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0440\u043e\u0431\u043e\u0442\u0438 \u043d\u0430\u0448\u0438\u0445 \u0431\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u043a\u0456\u0432, \u044f \u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u0430\u043c\u0438\u0441\u043b\u044e\u044e\u0441\u044f \u043d\u0430\u0434 \u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u0439\u043d\u043e-\u0442\u0435\u0445\u043d\u0456\u0447\u043d\u043e\u044e \u0447\u0430\u0441\u0442\u0438\u043d\u043e\u044e. \u0429\u043e\u0431 \u0434\u043e\u043b\u0435\u0442\u0456\u0442\u0438 \u0434\u043e \u041f\u0456\u0442\u0435\u0440\u0430, \u043d\u0430\u0448\u0438\u043c \u0411\u041f\u041b\u0410 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u043f\u043e\u0434\u043e\u043b\u0430\u0442\u0438 1000 \u043a\u043c \u0447\u0435\u0440\u0435\u0437 4 \u043e\u0431\u043b\u0430\u0441\u0442\u0456 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430. 4 \u043e\u0431\u043b\u0430\u0441\u0442\u0456, \u044f\u043a\u0456 \u0437\u0430\u0445\u0438\u0449\u0435\u043d\u0456 \u041f\u041f\u041e \u0442\u0430 \u0420\u0415\u0411. \u041f\u0440\u0438\u0447\u043e\u043c\u0443 \u0446\u0435 \u043d\u0435 \u043a\u0440\u0438\u043b\u0430\u0442\u0456 \u0440\u0430\u043a\u0435\u0442\u0438 \u0437 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0438\u043c\u0438 \u0441\u0456\u0441\u0442\u0435\u043c\u0430\u043c\u0438, \u0446\u0435 \u0411\u041f\u041b\u0410, \u044f\u043a\u0456 \u043b\u0435\u0442\u044f\u0442\u044c \u0437\u0456 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044e \u0434\u043e 200 \u043a\u043c/\u0433\u043e\u0434", "snippet_en": "\u041a\u043e\u043b\u0438 \u0432\u0441\u0456 \u0431\u0430\u0447\u0430\u0442\u044c \u0432\u0