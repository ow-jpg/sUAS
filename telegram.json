043c \u0438 120-\u043c\u043c \u043c\u0438\u043d\u043e\u043c\u0451\u0442\u044b, 12,7-\u043c\u043c \u043f\u0443\u043b\u0435\u043c\u0451\u0442\u044b M2, 7,62-\u043c\u043c T74, 5,56-\u043c\u043c M249, \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b\u0438\u0441\u044c \u0411\u041f\u041b\u0410 \u0438 \u0448\u0442\u0443\u0440\u043c\u043e\u0432\u044b\u0435 \u0432\u0438\u043d\u0442\u043e\u0432\u043a\u0438 T91. \u0424\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0431\u044b\u043b \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043d \u0432\u0435\u0441\u044c \u0441\u043f\u0435\u043a\u0442\u0440 \u0448\u0442\u0430\u0442\u043d\u043e\u0433\u043e \u0432\u043e\u043e", "snippet_en": "\u2757\ufe0f\ud83c\uddf9\ud83c\uddfc \u0423\u0447\u0435\u043d\u0438\u044f \u00ab\u0425\u0430\u043d\u044c \u0413\u0443\u0430\u043d-42\u00bb \u0414\u0430\u043d\u043d\u044b\u0435 \u043d\u0430 21.30 \u043c\u0441\u043a 10.08.2026 \u0433. \ud83d\udd3b \u041e\u0431\u043e\u0440\u043e\u043d\u0430 \u043e\u0441\u0442\u0440\u043e\u0432\u043e\u0432 \u041d\u0430 \u0430\u0440\u0445\u0438\u043f\u0435\u043b\u0430\u0433\u0435 \u041f\u044d\u043d\u0445\u0443 \u0432\u043e\u0439\u0441\u043a\u0430 \u043e\u0442\u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438 \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0440\u0441\u043a\u043e\u0433\u043e \u0438 \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0433\u043e \u0434\u0435\u0441\u0430\u043d\u0442\u0430. \u041f\u043e \u0443\u0441\u043b\u043e\u0432\u043d\u043e\u043c\u0443 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0443 \u0432\u0435\u043b\u0438 \u043e\u0433\u043e\u043d\u044c \u0442\u0430\u043d\u043a\u0438 M60A3, 105-\u043c\u043c \u0438 155-\u043c\u043c \u0433\u0430\u0443\u0431\u0438\u0446\u044b, 81-\u043c\u043c \u0438 120-\u043c\u043c \u043c\u0438\u043d\u043e\u043c\u0451\u0442\u044b, 12,7-\u043c\u043c \u043f\u0443\u043b\u0435\u043c\u0451\u0442\u044b M2, 7,62-\u043c\u043c T74, 5,56-\u043c\u043c M249, \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b\u0438\u0441\u044c \u0411\u041f\u041b\u0410 \u0438 \u0448\u0442\u0443\u0440\u043c\u043e\u0432\u044b\u0435 \u0432\u0438\u043d\u0442\u043e\u0432\u043a\u0438 T91. \u0424\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0431\u044b\u043b \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043d \u0432\u0435\u0441\u044c \u0441\u043f\u0435\u043a\u0442\u0440 \u0448\u0442\u0430\u0442\u043d\u043e\u0433\u043e \u0432\u043e\u043e", "link": "https://t.me/VictoryDrones/62174", "pubDate": "2026-08-10T20:11:47+00:00"}, {"channel": "VictoryDrones2023", "snippet": "https://www.rbc.ua/rus/news/ukrayinskiy-mavic-vyriy-industries-rozpovila-1786357533.html", "snippet_en": "https://www.rbc.ua/rus/news/ukrayinskiy-mavic-vyriy-industries-rozpovila-1786357533.html", "link": "https://t.me/VictoryDrones2023/28236", "pubDate": "2026-08-10T19:24:44+00:00"}, {"channel": "wartranslated", "snippet": "The Defence Intelligence of Ukraine struck two Russian S-400 \"Triumf\" launcher systems and a drone control antenna in Crimea. To strike the high-value Russian targets, the intelligence officers utilized Magura multipurpose maritime platforms equipped with FPV drones. The estimated losses of the Russian army resulting from the operation could reach tens of millions of dollars.", "snippet_en": "The Defence Intelligence of Ukraine struck two Russian S-400 \"Triumf\" launcher systems and a drone control antenna in Crimea. To strike the high-value Russian targets, the intelligence officers utilized Magura multipurpose maritime platforms equipped with FPV drones. The estimated losses of the Russian army resulting from the operation could reach tens of millions of dollars.", "link": "https://t.me/wartranslated/17987", "pubDate": "2026-08-10T09:14:54+00:00"}, {"channel": "lost_armour", "snippet": "\u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0437\u0430 10 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 2026 \u0433\u043e\u0434\u0430 00:06 - \u0414\u043e\u043d\u0431\u0430\u0441\u0441 02:35 - \u041a\u0440\u0430\u0441\u043d\u043e\u043b\u0438\u043c\u0430\u043d\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 03:32 - \u0411\u0435\u043b\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 04:30 - \u0421\u0443\u043c\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 05:02 - \u0421\u0431\u0440\u043e\u0441\u044b \u043f\u043e \u0446\u0435\u043b\u044f\u043c \u0412\u0421\u0423 05:42 - \u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0412\u0421\u0423 06:38 - \u0412\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441 \u0412\u041a\u0421 \u0420\u0424 \u043f\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044e \u041f\u0423 \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 07:37 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 08:25 - \u0411\u043e\u0435\u0432\u0430\u044f ", "snippet_en": "\u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0437\u0430 10 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 2026 \u0433\u043e\u0434\u0430 00:06 - \u0414\u043e\u043d\u0431\u0430\u0441\u0441 02:35 - \u041a\u0440\u0430\u0441\u043d\u043e\u043b\u0438\u043c\u0430\u043d\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 03:32 - \u0411\u0435\u043b\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 04:30 - \u0421\u0443\u043c\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 05:02 - \u0421\u0431\u0440\u043e\u0441\u044b \u043f\u043e \u0446\u0435\u043b\u044f\u043c \u0412\u0421\u0423 05:42 - \u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0412\u0421\u0423 06:38 - \u0412\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441 \u0412\u041a\u0421 \u0420\u0424 \u043f\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044e \u041f\u0423 \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 07:37 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 08:25 - \u0411\u043e\u0435\u0432\u0430\u044f ", "link": "https://t.me/lost_armour/10747", "pubDate": "2026-08-10T08:55:17+00:00"}, {"channel": "lost_armour", "snippet": "\u0414\u043e\u043d\u0431\u0430\u0441\u0441 \u0411\u043e\u043b\u0435\u0435 100 \u0431\u043e\u0435\u0432\u044b\u0445 \u0437\u0430\u0434\u0430\u0447 \u0438 \u043e\u043a\u043e\u043b\u043e 50 \u0441\u0431\u0438\u0442\u044b\u0445 \u0446\u0435\u043b\u0435\u0439. \u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u0411\u043f\u041b\u0410 \u0426\u0435\u043d\u0442\u0440\u0430 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u00bb \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043b \u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0438 \u0440\u0430\u0437\u0432\u0435\u0434\u044b\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0434\u0440\u043e\u043d\u043e\u0432 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430, \u0440\u0430\u0431\u043e\u0442\u0435 \u043d\u0430 \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u043e\u0439 \u0438 \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c. \ud83d\udd34 \u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u00bb \ud83d\udd34 Rutube \ud83d\udc4a \u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u0430\u00bb \u043d\u0430 Lostarmour \ud83d\udd34 \u0412\u0441\u0442\u0443\u043f\u0438\u0442\u044c \u0432 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u00bb: +79856759127 - \u041f\u0443\u043d\u043a\u0442 \u043e\u0442\u0431\u043e\u0440\u0430 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u00bb \u0411\u043e\u0442 \u043e\u0442\u0431\u043e\u0440\u0430 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u043e\u0432 \u041f\u0440\u043e\u043c\u043e", "snippet_en": "\u0414\u043e\u043d\u0431\u0430\u0441\u0441 \u0411\u043e\u043b\u0435\u0435 100 \u0431\u043e\u0435\u0432\u044b\u0445 \u0437\u0430\u0434\u0430\u0447 \u0438 \u043e\u043a\u043e\u043b\u043e 50 \u0441\u0431\u0438\u0442\u044b\u0445 \u0446\u0435\u043b\u0435\u0439. \u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u0411\u043f\u041b\u0410 \u0426\u0435\u043d\u0442\u0440\u0430 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u00bb \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043b \u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0438 \u0440\u0430\u0437\u0432\u0435\u0434\u044b\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0434\u0440\u043e\u043d\u043e\u0432 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430, \u0440\u0430\u0431\u043e\u0442\u0435 \u043d\u0430 \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u043e\u0439 \u0438 \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c. \ud83d\udd34 \u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u00bb \ud83d\udd34 Rutube \ud83d\udc4a \u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u0430\u00bb \u043d\u0430 Lostarmour \ud83d\udd34 \u0412\u0441\u0442\u0443\u043f\u0438\u0442\u044c \u0432 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u00bb: +79856759127 - \u041f\u0443\u043d\u043a\u0442 \u043e\u0442\u0431\u043e\u0440\u0430 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \u00ab\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u00bb \u0411\u043e\u0442 \u043e\u0442\u0431\u043e\u0440\u0430 \u043a\u0430\u043d\u0434\u0438\u0434\u0430\u0442\u043e\u0432 \u041f\u0440\u043e\u043c\u043e", "link": "https://t.me/lost_armour/10745", "pubDate": "2026-08-10T05:46:20+00:00"}, {"channel": "VictoryDrones2023", "snippet": "\u0417\u0431\u0438\u0442\u0442\u044f \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0434\u0440\u043e\u043d\u0456\u0432 \u0441\u0442\u0430\u0454 \u0449\u0435 \u0434\u0435\u0448\u0435\u0432\u0448\u0438\u043c \u0437\u0430\u0432\u0434\u044f\u043a\u0438 \u0441\u0456\u0442\u043a\u043e\u043c\u0435\u0442\u0430\u043c&#33;\ud83d\udd78\ufe0f \u042f\u043a \u0446\u0435 \u043f\u0440\u0430\u0446\u044e\u0454? \u041d\u0430 FPV-\u0434\u0440\u043e\u043d \u0437\u0430\u043c\u0456\u0441\u0442\u044c \u0431\u043e\u0439\u043e\u0432\u043e\u0457 \u0447\u0430\u0441\u0442\u0438\u043d\u0438 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u044e\u0442\u044c \u0441\u0456\u0442\u043a\u043e\u043c\u0435\u0442. \u041f\u0456\u0441\u043b\u044f \u043f\u043e\u0441\u0442\u0440\u0456\u043b\u0443 \u0441\u0456\u0442\u043a\u0430 \u0437\u0430\u043f\u043b\u0443\u0442\u0443\u0454 \u0439 \u0437\u0431\u0438\u0432\u0430\u0454 \u0432\u043e\u0440\u043e\u0436\u0438\u0439 \u0434\u0440\u043e\u043d, \u0430 \u043d\u0430\u0448 FPV \u043f\u043e\u0432\u0435\u0440\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u0431\u0430\u0437\u0443, \u043e\u0442\u0440\u0438\u043c\u0443\u0454 \u043d\u043e\u0432\u0443 \u0441\u0456\u0442\u043a\u0443 \u0442\u0430 \u0437\u043d\u043e\u0432\u0443 \u0433\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u0440\u043e\u0431\u043e\u0442\u0438. \u041f\u0440\u043e\u0441\u0442\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434: \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0430 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0437\u0431\u0438\u0442\u0442\u0456\u0432, \u0437\u0430\u0444\u0456\u043a\u0441\u043e\u0432\u0430\u043d\u0430 \u043e\u0434\u043d\u0438\u043c FPV-\u0434\u0440\u043e\u043d\u043e\u043c \u0456\u0437 \u0441\u0456\u0442\u043a\u043e\u043c\u0435\u0442\u043e\u043c, \u2014 24 \u043c\u0430\u0432\u0456\u043a\u0438. \u0426\u0435 \u043e\u0437\u043d\u0430\u0447\u0430\u0454 \u0431\u0456\u043b\u044c\u0448\u0435 \u0437\u0431\u0438\u0442\u0438\u0445", "snippet_en": "\u0417\u0431\u0438\u0442\u0442\u044f \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0434\u0440\u043e\u043d\u0456\u0432 \u0441\u0442\u0430\u0454 \u0449\u0435 \u0434\u0435\u0448\u0435\u0432\u0448\u0438\u043c \u0437\u0430\u0432\u0434\u044f\u043a\u0438 \u0441\u0456\u0442\u043a\u043e\u043c\u0435\u0442\u0430\u043c&#33;\ud83d\udd78\ufe0f \u042f\u043a \u0446\u0435 \u043f\u0440\u0430\u0446\u044e\u0454? \u041d\u0430 FPV-\u04