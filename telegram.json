3e\u0441\u043b\u0435 \u0430\u0442\u0430\u043a\u0438 \u0411\u041f\u041b\u0410, \u0441\u043e\u0441\u0435\u0434\u043d\u044f\u044f \u0443\u043b\u0438\u0446\u0430 \u0437\u0430\u043b\u0438\u0442\u0430 \u0432\u043e\u0434\u043e\u0439, \u2014 OSINT-\u0430\u043d\u0430\u043b\u0438\u0437 ASTRA \u041f\u043e\u0441\u043b\u0435 \u043d\u043e\u0447\u043d\u043e\u0439 \u0430\u0442\u0430\u043a\u0438 \u0411\u041f\u041b\u0410 \u043d\u0430 \u041d\u043e\u0432\u043e\u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a \u0432 \u0440\u0430\u0439\u043e\u043d\u0435 \u00ab\u041d\u043e\u0432\u043e\u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u0437\u0435\u0440\u043d\u043e\u0432\u043e\u0433\u043e \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u0430\u00bb \u043d\u0430 \u0443\u043b\u0438\u0446\u0435 \u041f\u043e\u0440\u0442\u043e\u0432\u0430\u044f \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0434\u044b\u043c, \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b OSINT-\u044d\u043a\u0441\u043f\u0435\u0440\u0442 ASTRA. \u041d\u0430 \u0441\u043e\u0441\u0435\u0434\u043d\u0435\u0439 \u041c\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0443\u043b\u0438\u0446\u0435 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d \u0442\u0440\u0443\u0431\u043e\u043f\u0440\u043e\u0432\u043e\u0434. \u041e\u0447\u0435\u0432\u0438\u0434\u0446\u044b \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0432\u044b\u0442\u0435\u043a\u0430\u043d\u0438\u0435 \u0438 \u0440\u0430\u0437\u043b\u0438\u0432 \u0432\u043e\u0434\u044b. \u041e\u041e\u041e \u00ab\u041d\u043e\u0432\u043e\u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0438\u0439 \u0437\u0435\u0440\u043d\u043e\u0432\u043e\u0439 \u0442\u0435\u0440\u043c\u0438\u043d\u0430", "link": "https://t.me/VictoryDrones/62252", "pubDate": "2026-08-12T10:52:44+00:00"}, {"channel": "VictoryDrones", "snippet": "\u0412 \u041d\u043e\u0432\u043e\u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0435 \u043f\u043e\u0441\u043b\u0435 \u0430\u0442\u0430\u043a\u0438 \u0411\u041f\u041b\u0410 \u0441\u0433\u043e\u0440\u0435\u043b\u043e \u043a\u0430\u0444\u0435 \u043d\u0430 \u0421\u0443\u0445\u0443\u043c\u0441\u043a\u043e\u043c \u0448\u043e\u0441\u0441\u0435, \u043d\u0435\u0434\u0430\u043b\u0435\u043a\u043e \u043e\u0442 \u0441\u0442\u043e\u044f\u043d\u043a\u0438 \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439 \u0412\u041c\u0424 \u0420\u0424, \u2014 OSINT-\u0430\u043d\u0430\u043b\u0438\u0437 ASTRA \u041f\u043e\u0441\u043b\u0435 \u0430\u0442\u0430\u043a\u0438 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u0445 \u0411\u041f\u041b\u0410 \u0432 \u041d\u043e\u0432\u043e\u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0435 \u0441\u0433\u043e\u0440\u0435\u043b\u043e \u043a\u0430\u0444\u0435 \u043f\u043e \u0430\u0434\u0440\u0435\u0441\u0443: \u0421\u0443\u0445\u0443\u043c\u0441\u043a\u043e\u0435 \u0448\u043e\u0441\u0441\u0435, 106, \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b OSINT-\u044d\u043a\u0441\u043f\u0435\u0440\u0442 ASTRA. \u041d\u0430 \u043a\u0430\u0434\u0440\u0430\u0445 \u043e\u0447\u0435\u0432\u0438\u0434\u0446\u0435\u0432 \u0432 \u043e\u043a\u043d\u0430\u0445 \u043f\u043e\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0437\u0430\u043c\u0435\u0442\u043d\u043e \u0432\u043e\u0437\u0433\u043e\u0440\u0430\u043d\u0438\u0435, \u043a\u0440\u044b\u0448\u0430 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043d\u0430, \u043a\u0430\u043a \u0438 \u0432\u0445\u043e\u0434\u043d\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430. \u0420\u044f\u0434\u043e\u043c \u0441 \u043a\u0430\u0444\u0435 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u044b\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u00ab\u041c\u0430\u0433\u043d\u0438\u0442\u00bb \u0438 \u0430\u043f\u0442\u0435", "snippet_en": "\u0412 \u041d\u043e\u0432\u043e\u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0435 \u043f\u043e\u0441\u043b\u0435 \