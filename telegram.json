043e\u0432\u043e\u043b\u043e\u043a\u043e\u043d\u043d\u043e\u0433\u043e FPV-\u0434\u0440\u043e\u043d\u0430 \"\u041a\u0412\u041d\" \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d \u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u041d\u0420\u0422\u041a \"Protector\" \u0412\u0421\u0423. \u041d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0438\u0439 \u0434\u0435\u043d\u044c \u044d\u0442\u043e \u0441\u0430\u043c\u044b\u0439 \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u041d\u0420\u0422\u041a \u0412\u0421\u0423 \u0441 \u0433\u0440\u0443\u0437\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e 1,5\u0442, \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c\u044b\u0439 \u0432 \u0447\u0430\u0441\u0442\u0438 \u041d\u0413\u0423 \u0438 \u0421\u0411\u0421 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0435\u0439 Ukrainian\u2026", "snippet_en": "\u0421\u043b\u0430\u0432\u043d\u0430\u044f \u0434\u043e\u0431\u044b\u0447\u0430&#33; \u0412 \u043f\u043e\u043b\u043e\u0441\u0435 \u043d\u0430\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0413\u0412 \"\u0421\u0435\u0432\u0435\u0440\" \u0443\u0434\u0430\u0440\u043e\u043c \u043e\u043f\u0442\u043e\u0432\u043e\u043b\u043e\u043a\u043e\u043d\u043d\u043e\u0433\u043e FPV-\u0434\u0440\u043e\u043d\u0430 \"\u041a\u0412\u041d\" \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d \u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u041d\u0420\u0422\u041a \"Protector\" \u0412\u0421\u0423. \u041d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0438\u0439 \u0434\u0435\u043d\u044c \u044d\u0442\u043e \u0441\u0430\u043c\u044b\u0439 \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u041d\u0420\u0422\u041a \u0412\u0421\u0423 \u0441 \u0433\u0440\u0443\u0437\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e 1,5\u0442, \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c\u044b\u0439 \u0432 \u0447\u0430\u0441\u0442\u0438 \u041d\u0413\u0423 \u0438 \u0421\u0411\u0421 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0435\u0439 Ukrainian\u2026", "link": "https://t.me/lost_armour/11913", "pubDate": "2026-10-22T19:55:51+00:00"}, {"channel": "VictoryDrones2023", "snippet": "\u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0442\u0435\u043a\u0443\u0449\u0438\u043c \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u0430\u043c \u041c\u0430\u0440\u043a\u0430 \u041a\u0440\u0443\u0442\u043e\u0432\u0430, \u0440\u0443\u0441\u0441\u043a\u0438\u0435 \u0441\u043e\u0437\u0434\u0430\u043b\u0438 \u0432\u043e\u043a\u0440\u0443\u0433 \u0441\u0432\u043e\u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0437\u0430\u0432\u043e\u0434\u0430 \u0411\u043f\u041b\u0410-\u043a\u0430\u043c\u0438\u043a\u0430\u0434\u0437\u0435 \u0432 \u0410\u043b\u0430\u0431\u0443\u0433\u0435 \u0443\u0436\u0435 33 \u0431\u0430\u0448\u043d\u0438 \u0438 \u0440\u0430\u043c\u043f\u044b \u041f\u0412\u041e. \u041a\u0440\u0443\u0442\u043e\u0432 \u043e\u0442\u043c\u0435\u0447\u0430\u0435\u0442, \u0447\u0442\u043e \u0423\u043a\u0440\u0430\u0438\u043d\u0430 \u043d\u0435 \u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044c \u0431\u0438\u0442\u044c \u043f\u043e \u044d\u0442\u043e\u043c\u0443 \u0437\u0430\u0432\u043e\u0434\u0443 \u0432\u043e\u0442 \u0443\u0436\u0435 \u0441 \u0438\u044e\u043d\u044f 2025 \u0433\u043e\u0434\u0430. @yigal_levin", "snippet_en": "\u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0442\u0435\u043a\u0443\u0449\u0438\u043c \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u0430\u043c \u041c\u0430\u0440\u043a\u0430 \u041a\u0440\u0443\u0442\u043e\u0432\u0430, \u0440\u0443\u0441\u0441\u043a\u0438\u0435 \u0441\u043e\u0437\u0434\u0430\u043b\u0438 \u0432\u043e\u043a\u0440\u0443\u0433 \u0441\u0432\u043e\u0435\u0433\u043e \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0437\u0430\u0432\u043e\u0434\u0430 \u0411\u043f\u041b\u0410-\u043a\u0430\u043c\u0438\u043a\u0430\u