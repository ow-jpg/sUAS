u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u043c\u043e\u0434\u0435\u0440\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0442\u0430\u043d\u043a\u043e\u0432\u044b\u0435 \u043c\u0438\u043d\u044b \u0441 \u0445\u0432\u043e\u0441\u0442\u043e\u0432\u0438\u043a\u0430\u043c\u0438. \u041a \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f FPV-\u0434\u0440\u043e\u043d \u00ab\u041a\u0412\u041d\u00bb. \u041f\u043e\u043f\u0430\u0434\u0430\u043d\u0438\u0435 \u043f\u043e \u0431\u043e\u0435\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0443 \u2014 \u0434\u0430\u043b\u044c\u0448\u0435 \u0441\u0432\u043e\u0451 \u0434\u0435\u043b\u043e \u0441\u0434\u0435\u043b\u0430\u043b\u0430 \u0434\u0435\u0442\u043e\u043d\u0430\u0446\u0438\u044f. \u0412 \u0440\u0430\u0431\u043e\u0442\u0435 \u0431\u043e\u0439\u0446\u044b 24-\u043e\u0439 \u0431\u0440\u0438\u0433", "snippet_en": "\ud83d\udd25 \u0418\u043d\u043e\u0433\u0434\u0430 \u043b\u0443\u0447\u0448\u0438\u0439 \u043f\u0440\u043e\u0432\u043e\u0434\u043d\u0438\u043a \u043a \u043f\u043e\u0437\u0438\u0446\u0438\u0438 \u0412\u0421\u0423 \u2014 \u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0434\u0440\u043e\u043d. \u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u0411\u041f\u041b\u0410 \u0432\u0437\u044f\u043b\u0438 \u0432 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u00ab\u0411\u0430\u0431\u0443-\u042f\u0433\u0443\u00bb \u0438 \u0434\u043e\u0448\u043b\u0438 \u0437\u0430 \u043d\u0435\u0439 \u0434\u043e \u0442\u043e\u0447\u043a\u0438 \u0431\u0430\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f. \u0410 \u0442\u0430\u043c \u2014 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u0441\u044e\u0440\u043f\u0440\u0438\u0437: \u0431\u043e\u043b\u0435\u0435 40 \u043a\u043e\u043c\u043f\u043b\u