u044f \u043d\u0430 \u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0438\u044e \u043a \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0443 \u043d\u0430 \u0431\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u0443\u044e \u043d\u0430\u0437\u0435\u043c\u043d\u0443\u044e \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u0443, \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0435\u043c\u0443\u044e \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u043c\u0438 \u041d\u0420\u0422\u041a, \u0431\u043e\u0435\u0432\u044b\u0435 \u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043c\u0430\u0448\u0438\u043d\u044b (\u0411\u0411\u041c) \u0432\u0441\u0435 \u0435\u0449\u0435 \u0438\u0433\u0440\u0430\u044e\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0440\u043e\u043b\u044c \u043f\u0440\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438 \u0437\u0430\u0434\u0430\u0447 \u043f\u043e \u0440\u043e\u0442\u0430\u0446\u0438\u0438 \u043b\u0438\u0447\u043d\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u0430, \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043e\u0431\u044a\u0435\u043c\u043e\u0432 \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u044f \u0438 \u0442\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0433\u043d\u0435\u0432\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 ", "snippet_en": "\ud83d\udd34 \u041e\u0445\u043e\u0442\u043d\u0438\u043a\u0438 \u043d\u0430 \u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0434\u0438\u043a\u043e\u0431\u0440\u0430\u0437\u043e\u0432 \u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u043f\u043e\u0440\u0430\u0437\u0438\u043b\u0438 2500 \u0431\u043e\u0435\u0432\u044b\u0445 \u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u0