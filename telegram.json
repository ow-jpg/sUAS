\u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u0434\u0430\u043b\u044c\u043d\u043e\u0431\u043e\u0439\u043d\u044b\u0435 \u043c\u043e\u0434\u0435\u043b\u0438, \u0432 \u0442.\u0447. \u0441\u0432\u044b\u0448\u0435 2400 \u0411\u041f\u041b\u0410 FP-2. \u041d\u0430 \u0431\u043e\u0435\u0432\u043e\u043c \u0441\u0447\u0435\u0442\u0443 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u0430\" \u0431\u043e\u043b\u0435\u0435 120 \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0411\u041f\u041b\u0410 \u0441\u0430\u043c\u043e\u043b\u0435\u0442\u043d\u043e\u0433\u043e \u0442\u0438\u043f\u0430 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0438 \u0437\u0430\u043f\u0430\u0434\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430. \u0421\u043f\u0438\u0441\u043e\u043a \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0447\u0430\u0441\u0442\u044b\u0445 (\u0431\u043e\u043b\u0435\u0435 200 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0439) \u0446\u0435\u043b\u0435\u0439 \u0441\u0430\u043c\u043e\u043b\u0435\u0442\u043d\u043e\u0433\u043e \u0442\u0438\u043f\u0430, \u043f\u0435\u0440", "snippet_en": "\ud83d\udd34\u041d\u0430 \u043f\u0435\u0440\u0432\u043e\u043c \u0440\u0443\u0431\u0435\u0436\u0435 \u041f\u0412\u041e \u0420\u0430\u0441\u0447\u0435\u0442\u044b FPV-\u041f\u0412\u041e \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442 \u0441\u0432\u044b\u0448\u0435 10 000 \u0411\u041f\u041b\u0410 \u0441\u0430\u043c\u043e\u043b\u0435\u0442\u043d\u043e\u0433\u043e \u0442\u0438\u043f\u0430 \u0412\u0421\u0423, \u0431\u043e\u043b\u0435\u0435 40% \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u0434\u0430\u043b\u044c\u043d\u043e\u0431\u043e\u0439\u043d\u044b\u0435 \u043c\u043e\u0434\u0435\u043b\u0438, \u0432 \u0442.\u0447. \u0441\u0432\u044b\u0448\u0435 2400 \u0411\u041f\u041b\u0410 FP-2. \u041d\u0430 \u0431\u043e\u0435\u0432\u043e\u043c \u0441\u0447\u0435\u0442\u0443 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u0430\" \u0431\u043e\u043b\u0435\u0435 120 \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0411\u041f\u041b\u0410 \u0441\u0430\u043c\u043e\u043b\u0435\u0442\u043d\u043e\u0433\u043e \u0442\u0438\u043f\u0430 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0443\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0438 \u0437\u0430\u043f\u0430\u0434\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430. \u0421\u043f\u0438\u0441\u043e\u043a \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0447\u0430\u0441\u0442\u044b\u0445 (\u0431\u043e\u043b\u0435\u0435 200 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0439) \u0446\u0435\u043b\u0435\u0439 \u0441\u0430\u043c\u043e\u043b\u0435\u0442\u043d\u043e\u0433\u043e \u0442\u0438\u043f\u0430, \u043f\u0435\u0440", "link": "https://t.me/lost_armour/12181", "pubDate": "2026-11-11T15:32:47+00:00"}, {"channel": "lost_armour", "snippet": "\ud83d\udd34 \u0423\u0434\u0430\u0440\u043d\u044b\u0439 \u043c\u0430\u0440\u0430\u0444\u043e\u043d \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043d\u0430\u043b\u043e\u043c \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e \u0441\u0432\u044b\u0448\u0435 60 000 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u0431\u043e\u0435\u0432\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u043f\u043e\u0434\u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f, \u043f\u0440\u0438 \u044d\u0442\u043e\u043c 50 000 \u0438\u0437 \u043d\u0438\u0445 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u043f\u0435\u0440\u0438\u043e\u0434 \u0447\u0443\u0442\u044c \u0431\u043e\u043b\u0435\u0435 \u0433\u043e\u0434\u0430 (\u0441 27.10.2025 \u043f\u043e 11.11.2026). \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430* \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439 (\u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447) \u043f\u043e \u0442\u0438\u043f\u0430\u043c: (*\u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0442\u0441\u0435\u0447\u043a\u0438 \u0432 55 000 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439) 51,9% (+2.2%) - \u0411\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u044b\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432 \u0442.\u0447: \u2022 29,1% (+0,1%) - ", "snippet_en": "\ud83d\udd34 \u0423\u0434\u0430\u0440\u043d\u044b\u0439 \u043c\u0430\u0440\u0430\u0444\u043e\u043d \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043d\u0430\u043b\u043e\u043c \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e \u0441\u0432\u044b\u0448\u0435 60 000 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u0431\u043e\u0435\u0432\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u043f\u043e\u0434\u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f, \u043f\u0440\u0438 \u044d\u0442\u043e\u043c 50 000 \u0438\u0437 \u043d\u0438\u0445 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u043f\u0435\u0440\u0438\u043e\u0434 \u0447\u0443\u0442\u044c \u0431\u043e\u043b\u0435\u0435 \u0433\u043e\u0434\u0430 (\u0441 27.10.2025 \u043f\u043e 11.11.2026). \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430* \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439 (\u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447) \u043f\u043e \u0442\u0438\u043f\u0430\u043c: (*\u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0442\u0441\u0435\u0447\u043a\u0438 \u0432 55 000 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439) 51,9% (+2.2%) - \u0411\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u044b\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432 \u0442.\u0447: \u2022 29,1% (+0,1%) - ", "link": "https://t.me/lost_armour/12178", "pubDate": "2026-11-11T13:17:24+00:00"}, {"channel": "lost_armour", "snippet": "\u0421\u0432\u0435\u0436\u0430\u044f \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0430 \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0448\u0438\u0445 FPV-\u0440\u0430\u0441\u0447\u0451\u0442\u043e\u0432 \u043d\u0430 \u0425\u0430\u0440\u044c\u043a\u043e\u0432\u0441\u043a\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438. \u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0432 \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0435 \u0443\u0434\u0435\u043b\u0435\u043d\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044e \u0440\u0430\u0441\u0447\u0451\u0442\u043e\u0432 \u0411\u041f\u041b\u0410 \u0412\u0421\u0423, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0443\u0441\u043f\u0435\u043b\u0438 \u0434\u043e\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u0434\u043e \u0441\u0432\u043e\u0438\u0445 \u043f\u043e\u0437\u0438\u0446\u0438\u0439. \u0421\u0440\u0435\u0434\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u2014 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0442\u044f\u0436\u0451\u043b\u043e\u0433\u043e \u0434\u0440\u043e\u043d\u0430 \u00ab\u0411\u0430\u0431\u0430-\u044f\u0433\u0430\u00bb, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0432\u0448\u0435\u0433\u043e\u0441\u044f \u0434\u043b\u044f \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0439 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0443\u044e\u0449\u0438\u0445, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d\u0438\u0435 \u0442\u0440\u0430\u043a\u0442\u043e\u0440\u0430, \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0432 \u0443\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u0438 \u043d\u043e\u0432\u043e\u0439 \u043e\u0431\u043e\u0440\u043e\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043b\u0438\u043d\u0438\u0438 \u0412\u0421\u0423. \u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0442 ", "snippet_en": "\u0421\u0432\u0435\u0436\u0430\u044f \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0430 \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0448\u0438\u0445 FPV-\u0440\u0430\u0441\u0447\u0451\u0442\u043e\u0432 \u043d\u0430 \u0425\u0430\u0440\u044c\u043a\u043e\u0432\u0441\u043a\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438. \u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0432 \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0435 \u0443\u0434\u0435\u043b\u0435\u043d\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044e \u0440\u0430\u0441\u0447\u0451\u0442\u043e\u0432 \u0411\u041f\u041b\u0410 \u0412\u0421\u0423, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0443\u0441\u043f\u0435\u043b\u0438 \u0434\u043e\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u0434\u043e \u0441\u0432\u043e\u0438\u0445 \u043f\u043e\u0437\u0438\u0446\u0438\u0439. \u0421\u0440\u0435\u0434\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u2014 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0442\u044f\u0436\u0451\u043b\u043e\u0433\u043e \u0434\u0440\u043e\u043d\u0430 \u00ab\u0411\u0430\u0431\u0430-\u044f\u0433\u0430\u00bb, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0432\u0448\u0435\u0433\u043e\u0441\u044f \u0434\u043b\u044f \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0439 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0443\u044e\u0449\u0438\u0445, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d\u0438\u0435 \u0442\u0440\u0430\u043a\u0442\u043e\u0440\u0430, \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0432 \u0443\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u0438 \u043d\u043e\u0432\u043e\u0439 \u043e\u0431\u043e\u0440\u043e\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043b\u0438\u043d\u0438\u0438 \u0412\u0421\u0423. \u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0442 ", "link": "https://t.me/lost_armour/12177", "pubDate": "2026-11-11T11:08:38+00:00"}, {"channel": "lost_armour", "snippet": "\u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0437\u0430 11 \u043d\u043e\u044f\u0431\u0440\u044f 2026 \u0433\u043e\u0434\u0430 00:05 - \u0414\u043e\u043d\u0431\u0430\u0441\u0441 03:02 - \u041a\u0440\u0430\u0441\u043d\u043e\u043b\u0438\u043c\u0430\u043d\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 03:27 - \u0421\u0443\u043c\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 04:25 - \u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0412\u0421\u0423 05:31 - \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u0435\u0445\u043e\u0442\u044b \u0412\u0421\u0423 06:41 - \u0412\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441 \u0412\u041a\u0421 \u0420\u0424 \u043f\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044e \u0446\u0435\u043b\u0435\u0439 \u0412\u0421\u0423 07:10 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u043e\u0447\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 07:39 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411", "snippet_en": "\u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0437\u0430 11 \u043d\u043e\u044f\u0431\u0440\u044f 2026 \u0433\u043e\u0434\u0430 00:05 - \u0414\u043e\u043d\u0431\u0430\u0441\u0441 03:02 - \u041a\u0440\u0430\u0441\u043d\u043e\u043b\u0438\u043c\u0430\u043d\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 03:27 - \u0421\u0443\u043c\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 04:25 - \u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0412\u0421\u0423 05:31 - \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u0435\u0445\u043e\u0442\u044b \u0412\u0421\u0423 06:41 - \u0412\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441 \u0412\u041a\u0421 \u0420\u0424 \u043f\u043e \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044e \u0446\u0435\u043b\u0435\u0439 \u0412\u0421\u0423 07:10 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u043e\u0447\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 07:39 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411", "link": "https://t.me/lost_armour/12175", "pubDate": "2026-11-11T09:09:43+00:00"}, {"channel": "combat_ftg2", "snippet": "\ud83c\uddfa\ud83c\udde6 NEW FUNDRAISER \u2014 2\u00d7 MAVIC 3T FOR THE \ud83d\udc0e110th BRIGADE \ud83c\udfaf Goal: &#036;9,800 Our mission is to purchase two DJI Mavic 3T thermal drones for the soldiers of Ukraine\u2019s 110th Brigade. These drones are especially important for nighttime operations, allowing our defenders to see in the dark, detect threats, and operate more safely. We know &#036;9,800 is a big goal and the road won\u2019t be easy \u2014 but with y", "snippet_en": "\ud83c\uddfa\ud83c\udde6 NEW FUNDRAISER \u2014 2\u00d7 MAVIC 3T FOR THE \ud83d\udc0e110th BRIGADE \ud83c\udfaf Goal: &#036;9,800 Our mission is to purchase two DJI Mavic 3T thermal drones for the soldiers of Ukraine\u2019s 110th Brigade. These drones are especially important for nighttime operations, allowing our defenders to see in the dark, detect threats, and operate more safely. We know &#036;9,800 is a big goal and the road won\u2019t be easy \u2014 but with y", "link": "https://t.me/combat_ftg2/3743", "pubDate": "2026-11-02T17:16:52+00:00"}, {"channel": "lost_armour", "snippet": "\ud83d\udd34 \u041e\u0445\u043e\u0442\u043d\u0438\u043a\u0438 \u043d\u0430 \u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0434\u0438\u043a\u043e\u0431\u0440\u0430\u0437\u043e\u0432 \u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u043f\u043e\u0440\u0430\u0437\u0438\u043b\u0438 2500 \u0431\u043e\u0435\u0432\u044b\u0445 \u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043c\u0430\u0448\u0438\u043d \u0412\u0421\u0423. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0438\u044e \u043a \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0443 \u043d\u0430 \u0431\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u0443\u044e \u043d\u0430\u0437\u0435\u043c\u043d\u0443\u044e \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u0443, \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0435\u043c\u0443\u044e \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u043c\u0438 \u041d\u0420\u0422\u041a, \u0431\u043e\u0435\u0432\u044b\u0435 \u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043c\u0430\u0448\u0438\u043d\u044b (\u0411\u0411\u041c) \u0432\u0441\u0435 \u0435\u0449\u0435 \u0438\u0433\u0440\u0430\u044e\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0440\u043e\u043b\u044c \u043f\u0440\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438 \u0437\u0430\u0434\u0430\u0447 \u043f\u043e \u0440\u043e\u0442\u0430\u0446\u0438\u0438 \u043b\u0438\u0447\u043d\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u0430, \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043e\u0431\u044a\u0435\u043c\u043e\u0432 \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u044f \u0438 \u0442\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0433\u043d\u0435\u0432\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 ", "snippet_en": "\ud83d\udd34 \u041e\u0445\u043e\u0442\u043d\u0438\u043a\u0438 \u043d\u0430 \u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0434\u0438\u043a\u043e\u0431\u0440\u0430\u0437\u043e\u0432 \u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u043f\u043e\u0440\u0430\u0437\u0438\u043b\u0438 2500 \u0431\u043e\u0435\u0432\u044b\u0445 \u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043c\u0430\u0448\u0438\u043d \u0412\u0421\u0423. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0438\u044e \u043a \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0443 \u043d\u0430 \u0431\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u0443\u044e \u043d\u0430\u0437\u0435\u043c\u043d\u0443\u044e \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u0443, \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0435\u043c\u0443\u044e \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u043c\u0438 \u041d\u0420\u0422\u041a, \u0431\u043e\u0435\u0432\u044b\u0435 \u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043c\u0430\u0448\u0438\u043d\u044b (\u0411\u0411\u041c) \u0432\u0441\u0435 \u0435\u0449\u0435 \u0438\u0433\u0440\u0430\u044e\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0440\u043e\u043b\u044c \u043f\u0440\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438 \u0437\u0430\u0434\u0430\u0447 \u043f\u043e \u0440\u043e\u0442\u0430\u0446\u0438\u0438 \u043b\u0438\u0447\u043d\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u0430, \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043e\u0431\u044a\u0435\u043c\u043e\u0432 \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u044f \u0438 \u0442\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0433\u043d\u0435\u0432\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 ", "link": "https://t.me/s/lost_armour", "pubDate": ""}, {"channel": "VictoryDrones", "snippet": "\u041d\u0435\u043c\u0446\u044b \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0430\u0432\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043b\u0430\u0437\u0435\u0440 \u0424\u0435\u0434\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u0435\u0434\u043e\u043c\u0441\u0442\u0432\u043e \u0431\u0443\u043d\u0434\u0435\u0441\u0432\u0435\u0440\u0430 \u043f\u043e \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u044e \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u043c (BAAINBw) \u0437\u0430\u043a\u043b\u044e\u0447\u0438\u043b\u043e \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442 \u0441 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0435\u0439 MBDA Deutschland \u043d\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u0446\u0430 \u043b\u0430\u0437\u0435\u0440\u043d\u043e\u0433\u043e \u043f\u043e\u0434\u0432\u0435\u0441\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u0430. \u0426\u0435\u043b\u044c \u2013 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0432\u044b\u0441\u043e\u043a\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0430 \u0411\u041f\u041b\u0410 \u0438 \u043a\u0440\u044b\u043b\u0430\u0442\u044b\u0445 \u0440\u0430\u043a\u0435\u0442 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430. \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u0430\u0432\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043b\u0430\u0437\u0435\u0440\u043e\u0432 \u0432 MBDA \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u00ab\u0432\u044b\u0441\u0448\u0438\u043c \u043f\u0438\u043b\u043e\u0442\u0430\u0436\u0435\u043c\u00bb \u043e\u0431\u043e\u0440\u043e\u043d", "snippet_en": "\u041d\u0435\u043c\u0446\u044b \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0430\u0432\u0438\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043b\u0430\u0437\u0435\u0440 \u0424\u0435\u0434\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u0435\u0434\u043e\u043c\u0441\u0442\u0432\u043e \u0431\u0443\u043d\u0434\u0435\u0441\u0432\u0435\u0440\u0430 \u043f\u043e \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u044e \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u043c (BAAINBw) \u0437\u0430\u043a\u043b\u044e\u0447\u0438\u043b\u043e \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442 \u0441 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0435\u0439 MBDA Deutschland \u043d\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043e\u0431\u0440\u0430\u0437\u0446\u0430 \u043b\u0430\u0437\u0435\u0440\u043d\u043e\u0433\u043e \u043f\u043e\u0434\u0432\u0435\u0441\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u0430. \u0426\u0435\u043b\u044c \u2013 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0432\u044b\u0441\u043e\u043a\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0430 \u0411\u041f\u041b\u0410 \u0