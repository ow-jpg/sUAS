u043c\u044b\u0448\u0435\u0432\u0430\u0445\u0430, \u0417\u0430\u043f\u043e\u0440\u043e\u0436\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u043b\u0441\u044f \u0432 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u044f\u0445 \"\u043f\u043e\u0434\u0437\u0435\u043c\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u044b\", \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u043e\u0439 \u0432 2025-\u043c \u0433\u043e\u0434\u0443 \u0438 \u043f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u0432\u0448\u0435\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u043c\u0443 \u043f\u0440\u043e\u0444\u0438\u043b\u044e \u043a 2026-\u043c\u0443 \u0433\u043e\u0434\u0443, \u043e \u0447\u0435\u043c \u0441\u043e\u043e\u0431\u0449\u0438\u043b\u0438 \u043c\u0435\u0441\u0442\u043d\u044b\u0435 \u0432\u043b\u0430\u0441\u0442\u0438 \u0432 \u043c\u0430\u0440\u0442\u0435 2026 \u0433\u043e\u0434\u0430. \u0423\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u0439 \u043f\u043e\u043b\u0438\u0442\u043e\u043b\u043e\u0433 \u0438 \u0432\u043e\u043b\u043e\u043d\u0442\u0435\u0440 \u0432 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u0435 2026 \u0440\u0430\u0441\u043a\u0440\u044b\u043b \u0434\u0435\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u043a", "snippet_en": "\"\u0417\u0430\u043a\u0440\u044b\u0442\u0430\u044f \u0448\u043a\u043e\u043b\u0430\" 2 \u043d\u043e\u044f\u0431\u0440\u044f 2026 \u0412\u041a\u0421 \u0420\u0424 \u043d\u0430\u043d\u0435\u0441\u043b\u0438 \u0443\u0434\u0430\u0440 \u043f\u043e \u0437\u0430\u0433\u043b\u0443\u0431\u043b\u0435\u043d\u043d\u043e\u043c\u0443 \u043f\u0443\u043d\u043a\u0442\u0443 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0412\u0421\u0423 \u0432 \u043d.\u043f. \u041a\u0430\u043c\u044b\u0448\u0435\u0432\u0430\u0445\u0430, \u0417\u0430\u043f\u043e\u0440\u043e\u0436\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u043b\u0441\u044f \u0432 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u044f\u0445 \"\u043f\u043e\u0434\u0437\u0435\u043c\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u044b\", \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u043e\u0439 \u0432 2025-\u043c \u0433\u043e\u0434\u0443 \u0438 \u043f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u0432\u0448\u0435\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u043c\u0443 \u043f\u0440\u043e\u0444\u0438\u043b\u044e \u043a 2026-\u043c\u0443 \u0433\u043e\u0434\u0443, \u043e \u0447\u0435\u043c \u0441\u043e\u043e\u0431\u0449\u0438\u043b\u0438 \u043c\u0435\u0441\u0442\u043d\u044b\u0435 \u0432\u043b\u0430\u0441\u0442\u0438 \u0432 \u043c\u0430\u0440\u0442\u0435 2026 \u0433\u043e\u0434\u0430. \u0423\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u0439 \u043f\u043e\u043b\u0438\u0442\u043e\u043b\u043e\u0433 \u0438 \u0432\u043e\u043b\u043e\u043d\u0442\u0435\u0440 \u0432 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u0435 2026 \u0440\u0430\u0441\u043a\u0440\u044b\u043b \u0434\u0435\u0442\u0430\u043b\u0438 \u0444\u0443\u043d\u043a", "link": "https://t.me/lost_armour/12074", "pubDate": "2026-11-03T21:15:12+00:00"}, {"channel": "VictoryDrones2023", "snippet": "\ud83d\udcf2\ufe0f\ufe0f\ufe0f\ufe0f\ufe0f\ufe0f \u0426\u0435\u043d\u0442\u0440 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0456\u0447\u043d\u0438\u0445 \u0440\u0456\u0448\u0435\u043d\u044c \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0443\u0454\u0442\u044c\u0441\u044f \u0437 \u0432\u0456\u0439\u0441\u044c\u043a\u043e\u0432\u043e\u0441\u043b\u0443\u0436\u0431\u043e\u0432\u0446\u0456\u0432-\u0430\u0439\u0442\u0456\u0432\u0446\u0456\u0432, \u0431\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c \u0437&#8239;\u044f\u043a\u0438\u0445 \u043c\u0430\u044e\u0442\u044c \u0431\u043e\u0439\u043e\u0432\u0438\u0439 \u0434\u043e\u0441\u0432\u0456\u0434. \u0429\u043e\u0431 \u0434\u043e\u043b\u0443\u0447\u0438\u0442\u0438\u0441\u044f \u0434\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u0438, \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0439\u0442\u0435 \u0432\u0456\u0434\u0433\u0443\u043a\u0438 \u043d\u0430 \u0442\u0430\u043a\u0456 \u0432\u0430\u043a\u0430\u043d\u0441\u0456\u0457: \u2022 \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a \u0424\u0415\u0421 \u2022 \u0412\u043e\u0434\u0456\u0439-\u0441\u0430\u043d\u0456\u0442\u0430\u0440 \u043c\u0435\u0434\u0438\u0447\u043d\u043e\u0433\u043e \u043f\u0443\u043d\u043a\u0442\u0443 \u2022 \u041a\u043e\u043c\u0430\u043d\u0434\u0438\u0440 \u0435\u043a\u0456\u043f\u0430\u0436\u0443 \u041d\u0420\u041a \u2022 \u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u0411\u041f\u041b\u0410 \u2022 \u0421\u0430\u043f\u0435\u0440 \u2022 \u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u0420\u041b\u0421 \u2022 \u041e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u0438\u0439 \u0447\u0435\u0440\u0433\u043e\u0432\u0438\u0439 \u043f\u0443\u043d\u043a\u0442\u0443 \u0443\u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u043f\u0456\u0434\u0440\u043e\u0437\u0434\u0456\u043b\u0443 \u0411\u043f\u041b\u0410 \u2022 \u041e\u0444\u0456\u0446\u0435\u0440 \u0441\u043b\u0443\u0436\u0431\u0438 \u043e\u0445\u043e\u0440\u043e\u043d\u0438 \u0434\u0435\u0440", "snippet_en": "\ud83d\udcf2\ufe0f\ufe0f\ufe0f\ufe0f\ufe0f\ufe0f \u0426\u0435\u043d\u0442\u0440 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0456\u0447\u043d\u0438\u0445 \u0440\u0456\u0448\u0435\u043d\u044c \u043a\u043e\u043c\u043f\u043b\u0435\u043