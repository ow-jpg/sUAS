43e\u0441\u0432\u044f\u0449\u0435\u043d \u0431\u043e\u0435\u0432\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043f\u043e \u043f\u0435\u0445\u043e\u0442\u0435 \u0412\u0421\u0423 \u043f\u0438\u043b\u043e\u0442\u0430 4 \u041e\u041c\u0421\u0411\u0440 \u0441 \u043f\u043e\u0437\u044b\u0432\u043d\u044b\u043c \"\u0421\u043f\u0430\u0440\u0442\u0430\u043d\u0435\u0446\". \u0417\u0430 \u0434\u0432\u0430 \u0433\u043e\u0434\u0430 \u043f\u043e\u043b\u0435\u0442\u043e\u0432 \u043d\u0430 \u043e\u043f\u0442\u043e\u0432\u043e\u043b\u043e\u043a\u043e\u043d\u043d\u044b\u0445 FPV-\u0434\u0440\u043e\u043d\u0430\u0445 \u043d\u0430 \u0441\u0447\u0435\u0442\u0443 \u043f\u0438\u043b\u043e\u0442\u0430 \u0441\u043e\u0442\u043d\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430. \u0425\u043b\u0430\u0434\u043d\u043e\u043a\u0440\u043e\u0432\u0438\u0435, \u0432\u044b\u0434\u0435\u0440\u0436\u043a\u0430 \u0438 \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0440\u0430\u0437\u0431\u043e\u0440 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043f\u043e\u043b\u0435\u0442\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438 \u0434\u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u0430 \u043e\u0442\u0442\u043e\u0447\u0438\u0442\u044c \u043d\u0430\u0432\u044b\u043a\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u0440\u043e\u043d\u0430\u043c\u0438, \u0447\u0442\u043e \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442", "snippet_en": "\u041e\u043f\u0442\u043e\u0432\u043e\u043b\u043e\u043a\u043e\u043d\u043d\u044b\u0439 \u0430\u043b\u044c\u043c\u0430\u043d\u0430\u0445. \u0420\u0435\u0437\u043d\u044f. \u042d\u043f\u0438\u0437\u043e\u0434 11. \u041e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0439 \u0432\u044b\u043f\u0443\u0441\u043a \"\u041e\u043f\u0442\u043e\u0432\u043e\u043b\u043e\u043a\u043e\u043d\u043d\u043e\u0433\u043e \u0430\u043b\u044c\u043c\u0430\u043d\u0430\u0445\u0430\" \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d \u0431\u043e\u0435\u0432\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043f\u043e \u043f\u0435\u0445\u043e\u0442\u0435 \u0412\u0421\u0423 \u043f\u0438\u043b\u043e\u0442\u0430 4 \u041e\u041c\u0421\u0411\u0440 \u0441 \u043f\u043e\u0437\u044b\u0432\u043d\u044b\u043c \"\u0421\u043f\u0430\u0440\u0442\u0430\u043d\u0435\u0446\". \u0417\u0430 \u0434\u0432\u0430 \u0433\u043e\u0434\u0430 \u043f\u043e\u043b\u0435\u0442\u043e\u0432 \u043d\u0430 \u043e\u043f\u0442\u043e\u0432\u043e\u043b\u043e\u043a\u043e\u043d\u043d\u044b\u0445 FPV-\u0434\u0440\u043e\u043d\u0430\u0445 \u043d\u0430 \u0441\u0447\u0435\u0442\u0443 \u043f\u0438\u043b\u043e\u0442\u0430 \u0441\u043e\u0442\u043d\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430. \u0425\u043b\u0430\u0434\u043d\u043e\u043a\u0440\u043e\u0432\u0438\u0435, \u0432\u044b\u0434\u0435\u0440\u0436\u043a\u0430 \u0438 \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0440\u0430\u0437\u0431\u043e\u0440 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043f\u043e\u043b\u0435\u0442\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u0438 \u0434\u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u0430 \u043e\u0442\u0442\u043e\u0447\u0438\u0442\u044c \u043d\u0430\u0432\u044b\u043a\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u0440\u043e\u043d\u0430\u043c\u0438, \u0447\u0442\u043e \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442", "link": "https://t.me/s/lost_armour", "pubDate": ""}], "updated": "7 Sep 2026, 21:50 UTC", "count": 13}