43e\u0442\u0438\u0432\u043d\u0438\u043a\u0430, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0431\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u044b\u043c \u043b\u0438\u0434\u0435\u0440\u043e\u043c \u043f\u043e \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f FPV-\u0434\u0440\u043e\u043d\u043e\u0432 \u0441\u0440\u0435\u0434\u0438 \u0432\u0441\u0435\u0445 \u043f\u043e\u0434\u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0439, \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e\u0449\u0438\u0445 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0421\u0412\u041e. \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043d\u0430\u043b\u043e\u043c \u043f\u043e\u0434\u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e \u0441\u0432\u044b\u0448\u0435 45 000 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0446\u0435\u043b\u0435\u0439 \u043f\u0440", "snippet_en": "\ud83d\udd34 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u043d\u0430 \u043c\u0438\u043b\u043b\u0438\u043e\u043d&#33; \u0417\u0430 \u0438\u0441\u0442\u0435\u043a\u0448\u0438\u0435 20 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0441 \u044f\u043d\u0432\u0430\u0440\u044f 2025 \u043f\u043e \u0430\u0432\u0433\u0443\u0441\u0442 2026 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b\u0438 \u0431\u043e\u043b\u0435\u0435 1 000 000 FPV-\u0434\u0440\u043e\u043d\u043e\u0432, \u043f\u043e\u0440\u0430\u0437\u0438\u0432 \u0441\u0432\u044b\u0448\u0435 280 000 \u0446\u0435\u043b\u0435\u0439 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u04