433\u0438 \u0430\u0432\u0433\u0443\u0441\u0442\u0430 2026. \u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u0431\u043e\u0435\u0432\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0432 \u0430\u0432\u0433\u0443\u0441\u0442\u0435 2026 \u043f\u0440\u0435\u0432\u044b\u0441\u0438\u043b\u043e 4700 - \u0442\u0440\u0435\u0442\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0437\u0430 \u0432\u0441\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0439. \u0420\u043e\u0441\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439 \u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e \u0441 \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u044b\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u043c 2025 \u0433\u043e\u0434\u0430 - \u0432 2,7 \u0440\u0430\u0437\u0430. \u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u043e\u0439 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e \u0438\u0441\u0442\u0435\u043a\u0448\u0435\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u0441\u0442\u0430\u043b\u043e \u0440\u0435\u043a\u043e\u0440\u0434\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0443\u0434\u0430\u0440\u043e\u0432 \u043f\u043e \u0431\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u044b\u043c \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u043c \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430: 3000", "link": "https://t.me/lost_armour/11046", "pubDate": "2026-08-31T13:35:49+00:00"}, {"channel": "VictoryDrones", "snippet": 