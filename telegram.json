2\u0438\u043f\u0430, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043f\u043e \u0437\u0430\u0449\u0438\u0442\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043e \u0442\u0440\u0430\u0441\u0441\u0435 \u0420280 \u00ab\u041d\u043e\u0432\u043e\u0440\u043e\u0441\u0441\u0438\u044f\u00bb. \u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \"\u0412\u0430\u0440\u044f\u0433\u0430", "snippet_en": "\u041e\u0431\u0449\u0435\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043d\u0430\u043b\u043e\u043c 50 \u041e\u0411\u0440\u0411\u043f\u0421 \"\u0412\u0430\u0440\u044f\u0433\" \u0443\u0434\u0430\u0440\u043e\u0432 \u043f\u043e \u0446\u0435\u043b\u044f\u043c \u0412\u0421\u0423 \u043f\u0440\u0435\u0432\u044b\u0441\u0438\u043b\u043e 5000&#33; \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \"\u0412\u0430\u0440\u044f\u0433\u0430\" \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442\u0441\u044f \u0430\u043a\u0446\u0435\u043d\u0442\u043e\u043c \u043d\u0430 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0442\u044b\u043b\u043e\u0432\u044b\u0445 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043d\u044b\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0434\u0430\u043b\u044c\u043d\u043e\u0431\u043e\u0439\u043d\u044b\u043c\u0438 \u0443\u0434\u0430\u0440\u043d\u044b\u043c\u0438 \u0434\u0440\u043e\u043d\u0430\u043c\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0438 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u043c \u0411\u041f\u041b\u0410 \u0441\u0430\u043c\u043e\u043b\u0435\u0442\u043d\u043e\u0433\u043e \u0442\u0438\u043f\u0430, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435 \u043f\u043e \u0437\u0430\u0449\u0438\u0442\u0435 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043e \u0442\u0440\u0430\u0441\u0441\u0435 \u0420280 \u00ab\u041d\u043e\u0432\u043e\u0440\u043e\u0441\u0441\u0438\u044f\u00bb. \u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \"\u0412\u0430\u0440\u044f\u0433\u0430", "link": "https://t.me/lost_armour/11366", "pubDate": "2026-09-20T03:51:06+00:00"}, {"channel": "lost_armour", "snippet": "\u0411\u0440\u0430\u0432\u043e, \u043c\u0430\u044d\u0441\u0442\u0440\u043e&#33; \u041f\u0438\u043b\u043e\u0442 \u043e\u043f\u0442\u043e\u0432\u043e\u043b\u043e\u043a\u043e\u043d\u043d\u044b\u0445 FPV-\u0434\u0440\u043e\u043d\u043e\u0432 \"\u041a\u0412\u041d\" \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0438 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u043b \u0431\u0440\u043e\u043d\u0435\u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0435\u0440 VCC-1 (\u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0430\u044f \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f M113) \u0412\u0421\u0423 \u0432 \u0425\u0430\u0440\u044c\u043a\u043e\u0432\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u041f\u0435\u0440\u0432\u044b\u043c \u0434\u0440\u043e\u043d\u043e\u043c \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e \u0441\u043f\u0438\u043a\u0438\u0440\u043e\u0432\u0430\u043b \u0438 \u043f\u043e\u0440\u0430\u0437\u0438\u043b \u043b\u043e\u0431\u043e\u0432\u0443\u044e \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u044e \u0431\u0440\u043e\u043d\u0435\u043c\u0430\u0448\u0438\u043d\u044b. \u0412\u0442\u043e\u0440\u044b\u043c - \u0432\u0438\u0440\u0442\u0443\u043e\u0437\u043d\u043e \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u043b \u0441\u0435\u0442\u0447\u0430\u0442\u044b\u0439 \u044d\u043a\u0440\u0430\u043d \u0443 \u0441\u0430\u043c\u043e\u0439 \u0437\u0435\u043c\u043b\u0438 \u0438, \u0437\u0430\u043b\u0435\u0442\u0435\u0432 \u0432\u043e \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u043e\u0431\u044a\u0435\u043c \u0411\u0422\u0420\u0430, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u043e\u043f\u0446\u0438\u044e \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u0434\u0440\u044b\u0432\u0430. \u041e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043a\u0430\u043a \u043d\u0435\u043e\u0442\u044a\u0435\u043c\u043b", "snippet_en": "\u0411\u0440\u0430\u0432\u043e, \u043c\u0430\u044d\u0441\u0442\u0440\u043e&#33; \u041f\u0438\u043b\u043e\u0442 \u043e\u043f\u0442\u043e\u0432\u043e\u043b\u043e\u043a\u043e\u043d\u043d\u044b\u0445 FPV-\u0434\u0440\u043e\u043d\u043e\u0432 \"\u041a\u0412\u041d\" \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0438 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u043b \u0431\u0440\u043e\u043d\u0435\u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0435\u0440 VCC-1 (\u0438\u0442\u0430\u043b\u044c\u044f\u043d\u0441\u043a\u0430\u044f \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f M113) \u0412\u0421\u0423 \u0432 \u0425\u0430\u0440\u044c\u043a\u043e\u0432\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u041f\u0435\u0440\u0432\u044b\u043c \u0434\u0440\u043e\u043d\u043e\u043c \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e \u0441\u043f\u0438\u043a\u0438\u0440\u043e\u0432\u0430\u043b \u0438 \u043f\u043e\u0440\u0430\u0437\u0438\u043b \u043b\u043e\u0431\u043e\u0432\u0443\u044e \u043f\u0440\u043e\u0435\u043a\u0446\u0438\u044e \u0431\u0440\u043e\u043d\u0435\u043c\u0430\u0448\u0438\u043d\u044b. \u0412\u0442\u043e\u0440\u044b\u043c - \u0432\u0438\u0440\u0442\u0443\u043e\u0437\u043d\u043e \u043f\u0440\u0435\u043e\u0434\u043e\u043b\u0435\u043b \u0441\u0435\u0442\u0447\u0430\u0442\u044b\u0439 \u044d\u043a\u0440\u0430\u043d \u0443 \u0441\u0430\u043c\u043e\u0439 \u0437\u0435\u043c\u043b\u0438 \u0438, \u0437\u0430\u043b\u0435\u0442\u0435\u0432 \u0432\u043e \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u043e\u0431\u044a\u0435\u043c \u0411\u0422\u0420\u0430, \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043b \u043e\u043f\u0446\u0438\u044e \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u0434\u0440\u044b\u0432\u0430. \u041e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043a\u0430\u043a \u043d\u0435\u043e\u0442\u044a\u0435\u043c\u043b", "link": "https://t.me/lost_armour/11365", "pubDate": "2026-09-19T20:09:09+00:00"}, {"channel": "lost_armour", "snippet": "\u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0437\u0430 19 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 2026 \u0433\u043e\u0434\u0430 00:05 - \u0414\u043e\u043d\u0431\u0430\u0441\u0441 03:08 - \u041a\u0440\u0430\u0441\u043d\u043e\u043b\u0438\u043c\u0430\u043d\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 04:24 - \u0421\u0443\u043c\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 05:24 - \u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u044f \u0441\u043e\u044e\u0437\u043d\u044b\u043c \u043f\u043e\u0434\u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f\u043c 05:46 - \u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0412\u0421\u0423 06:53 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 07:44 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u043e\u0447\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 08:10 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0440\u0430", "snippet_en": "\u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0437\u0430 19 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 2026 \u0433\u043e\u0434\u0430 00:05 - \u0414\u043e\u043d\u0431\u0430\u0441\u0441 03:08 - \u041a\u0440\u0430\u0441\u043d\u043e\u043b\u0438\u043c\u0430\u043d\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 04:24 - \u0421\u0443\u043c\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 05:24 - \u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u044f \u0441\u043e\u044e\u0437\u043d\u044b\u043c \u043f\u043e\u0434\u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f\u043c 05:46 - \u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0412\u0421\u0423 06:53 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u043d\u0435\u0432\