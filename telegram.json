u0442\u0430 \u0434\u0440\u043e\u043d\u0430\u043c\u0438 \u0456\u043d\u0448\u0438\u0445 \u0442\u0438\u043f\u0456\u0432, \u0430 \u0442\u0430\u043a\u043e\u0436 6-\u043c\u0430 S-8000 \u0411\u0430\u043d\u0434\u0435\u0440\u043e\u043b\u044c/\u0414\u0430\u043d\u044c-\u0422. \u0417\u0430 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u043c\u0438 \u0434\u0430\u043d\u0438\u043c\u0438, \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0432\u043a\u0430\u0437\u0430\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0456\u043e\u0434\u0443, \u041f\u041f\u041e \u0437\u0431\u0438\u0442\u043e/\u043f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u043e 140 \u0411\u043f\u041b\u0410 (22 \u0456\u0437 \u043d\u0438\u0445 - \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u0456), \u0430 \u0442\u0430\u043a\u043e\u0436 6 S-8000 \u0411\u0430\u043d\u0434\u0435\u0440\u043e\u043b\u044c/\u0414\u0430\u043d\u044c-\u0422. \u0421\u0442\u0430", "snippet_en": "\ud83d\udcaa \u041f\u041f\u041e \u0437\u043d\u0435\u0448\u043a\u043e\u0434\u0438\u043b\u0430 140 \u0437\u0456 157 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0411\u043f\u041b\u0410 \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0434\u043d\u044f, - \u041f\u043e\u0432\u0456\u0442\u0440\u044f\u043d\u0456 \u0441\u0438\u043b\u0438 \u041f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0434\u043d\u044f 17 \u0436\u043e\u0432\u0442\u043d\u044f (\u0456\u0437 7:30 \u043f\u043e 19:30) \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a \u0430\u0442\u0430\u043a\u0443\u0432\u0430\u0432 \u0423\u043a\u0440\u0430\u0457\u043d\u0443 157 \u0443\u0434\u0430\u0440\u043d\u0438\u043c\u0438 \u0411\u043f\u041b\u0410 (25 \u0456\u0437 \u043d\u0438\u0445 - \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u0456), \u0413\u0435\u0440\u0431\u0435\u0440\u0430 \u0442\u0430 \u0434\u0440\u043e\u043d\u0430\u043c\u0438 \u0456\u043d\u0448\u0438\u0445 \u0442\u0438\u043f\u0456\u0432, \u0430 \u0442\u0430\u043a\u043e\u0436 6-\u043c\u0430 S-8000 \u0411\u0430\u043d\u0434\u04