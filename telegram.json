447\u0435\u0442\u044b\u0440\u0451\u0445\u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043d\u0430\u044f CRP-\u0430\u043d\u0442\u0435\u043d\u043d\u0430, \u0441\u043e\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u0438\u0437 \u0447\u0435\u0442\u044b\u0440\u0435\u0445 \u043f\u0430\u0442\u0447-\u0430\u043d\u0442\u0435\u043d\u043d \u0441 \u0434\u0432\u043e\u0439\u043d\u044b\u043c \u043f\u0438\u0442\u0430\u043d\u0438\u0435\u043c \u043e\u0442 Kyocera AVX - 1002649, \u0441 \u043f\u043e\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u0435\u0439 \u0432 \u043e\u0434\u043d\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438. \u041e\u0442", "snippet_en": "\ud83d\udce3\ud83d\udce3\ud83d\udce3\ud83d\udce3\ud83d\udce3\ud83d\udce3 \u0423\u0432\u0430\u0436\u0430\u0435\u043c\u044b\u0435 \u043a\u043e\u043b\u043b\u0435\u0433\u0438&#33; \u0412 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435 \u0442\u0435\u043c\u044b \u043f\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044e \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u043c \u0443\u0434\u0430\u0440\u043d\u044b\u0445 \u0411\u043f\u041b\u0410 \u0440\u0430\u0441\u0441\u043a\u0430\u0436\u0435\u043c \u043e\u0431 \u0430\u043d\u0442\u0435\u043d\u043d\u0435, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044e \u0443\u0434\u0430\u0440\u043d\u0438\u043a\u0430\u043c. \u0414\u0430\u043d\u043d\u0430\u044f \u0430\u043d\u0442\u0435\u043d\u043d\u0430 \u0432\u0445\u043e\u0434\u0438\u043b\u0430 \u0432 \u0441\u043e\u0441\u0442\u0430\u0432 \u0443\u0434\u0430\u0440\u043d\u043e\u0433\u043e \u0411\u043f\u041b\u0410 \u0427\u0430\u043a\u043b\u0443\u043d-\u0411 \u043a\u043b\u0430\u0441\u0441\u0430 middle strike. \u041f\u0435\u0440\u0435\u0434 \u043d\u0430\u043c\u0438 \u0447\u0435\u0442\u044b\u0440\u0451\u0445\u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043d\u0430\u044f CRP-\u0430\u043d\u0442\u0435\u043d\u043d\u0430, \u0441\u043e\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u0438\u0437 \u0447\u0435\u0442\u044b\u0440\u0435\u0445 \u043f\u0430\u0442\u0447-\u0430\u043d\u0442\u0435\u043d\u043d \u0441 \u0434\u0432\u043e\u0439\u043d\u044b\u043c \u043f\u0438\u0442\u0430\u043d\u0438\u0435\u043c \u043e\u0442 Kyocera AVX - 1002649, \u0441 \u043f\u043e\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u0435\u0439 \u0432 \u043e\u0434\u043d\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438. \u041e\u0442", "link": "https://t.me/VictoryDrones/66347", "pubDate": "2026-10-09T12:21:59+00:00"}, {"channel": "VictoryDrones", "snippet": "\u041f\u0430\u0440\u0430 \u0441\u043b\u043e\u0432 \u043f\u0440\u043e \u041c\u041e\u0413\u0438 \u0421\u0435\u0439\u0447\u0430\u0441 \u0435\u0441\u0442\u044c \u043c\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u043d\u044b\u0445 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0439, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0434\u043e\u0431\u0430\u0432\u043b\u044e \u0441\u0432\u043e\u0438 5 \u043a\u043e\u043f\u0435\u0435\u043a: 1\ufe0f\u20e3 \u0427\u0430\u0441\u0442\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0443\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c\u0441\u044f \u0432 60\u201390 \u0441\u0435\u043a\u0443\u043d\u0434 \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u043e\u0433\u043d\u044f. \u041e\u0434\u043d\u0430\u043a\u043e \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0432\u0440\u0435\u043c\u044f \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0440\u0435\u043b\u044c\u0435\u0444\u0430, \u0432\u043e\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430, \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0446\u0435\u043b\u0438 \u0438 