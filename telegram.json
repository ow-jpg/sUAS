3e\u043a\u043e\u043d\u043d\u044b\u0439 \u0430\u043b\u044c\u043c\u0430\u043d\u0430\u0445. \u0420\u0435\u0437\u043d\u044f. \u042d\u043f\u0438\u0437\u043e\u0434 7. \u0412 \u043d\u0430\u0448\u0435\u0439 \u0430\u0440\u043c\u0438\u0438 \u043d\u0435\u043c\u0430\u043b\u043e \u043f\u0435\u0440\u0432\u043e\u043a\u043b\u0430\u0441\u0441\u043d\u044b\u0445 \u043f\u0438\u043b\u043e\u0442\u043e\u0432 FPV-\u0434\u0440\u043e\u043d\u043e\u0432, \u0441\u0440\u0435\u0434\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u0441\u0442\u044c \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u043b\u0435\u0433\u0435\u043d\u0434\u044b, \u0447\u0435\u0439 \u0431\u043e\u0435\u0432\u043e\u0439 \u043f\u0443\u0442\u044c \u0443\u0441\u0435\u044f\u043d \u0441\u043e\u0442\u043d\u044f\u043c\u0438 \u0435\u0434\u0438\u043d\u0438\u0446 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430. \u041e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0439 \u0432\u044b\u043f\u0443\u0441\u043a \"\u041e\u043f\u0442\u043e\u0432\u043e\u043b\u043e\u043a\u043e\u043d\u043d\u043e\u0433\u043e \u0430\u043b\u044c\u043c\u0430\u043d\u0430\u0445\u0430\" \u043f\u043e\u0441\u0432\u044f\u0449\u0435\u043d\u2026", "snippet_en": "\u041e\u043f\u0442\u043e\u0432\u043e\u043b\u043e\u043a\u043e\u043d\u043d\u044b\u0439 \u0430\u043b\u044c\u043c\u0430\u043d\u0430\u0445. \u0420\u0435\u0437\u043d\u044f. \u042d\u043f\u0438\u0437\u043e\u0434 7. \u0412 \u043d\u0430\u0448\u0435\u0439 \u0430\u0440\u043c\u0438\u0438 \u043d\u0435\u043c\u0430\u043b\u043e \u043f\u0435\u0440\u0432\u043e\u043a\u043b\u0430\u0441\u0441\u043d\u044b\u0445 \u043f\u0438\u043b\u043e\u0442\u043e\u0432 FPV-\u0434\u0440\u043e\u043d\u043e\u0432, \u0441\u0440\u0435\u0434\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u0441\u0442\u044c \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u043b\u0435\u0433\u0435\u043d\u0434\u044b, \u0447\u0435\u0439 \u0431\u043e\u043