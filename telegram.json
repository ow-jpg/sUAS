3d\u043e\u0439 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b, \u043a\u043e\u043c\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u0446\u0435\u043d\u0442\u0440\u0430\u043c \u0438 \u043c\u043e\u0440\u0441\u043a\u0438\u043c \u0441\u0443\u0434\u0430\u043c, \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u0432 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430\u0445 \u0412\u0421\u0423. \u0412 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u0443\u0434\u0430\u0440\u043e\u0432 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u044b: \ud83d\udccd\u0432 \u041a\u0438\u0435\u0432\u0435 \u25aa\ufe0f\u0446\u0435\u043d\u0442\u0440 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0434\u0430\u043d\u043d\u044b\u0445 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u00ab\u0412\u041e\u0414\u0410\u0424\u041e\u041d\u00bb, \u044f\u0432\u043b\u044f\u044e\u0449\u0435\u0439\u0441\u044f \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0445 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0439, \u043f\u0440\u0435\u0434\u043e\u0441", "snippet_en": "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u043d\u043e\u0447\u044c\u044e \u0412\u043e\u043e\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u043c\u0438 \u0421\u0438\u043b\u0430\u043c\u0438 \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u043e \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u0438\u0435 \u0443\u0434\u0430\u0440\u043e\u0432 \u0431\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u044b\u043c\u0438 \u043b\u0435\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438 \u043f\u043e \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0446\u0435\u043d\u0442\u0440\u0430\