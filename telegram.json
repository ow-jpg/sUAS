30\u043b\u0438 \u0442\u044f\u0436\u0451\u043b\u044b\u0439 \u0431\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u0438\u043a Heavy Shot \u0410\u044e\u0434\u0430\u0433\u20116 (\u0433\u0440\u0443\u0437\u043e\u043f\u043e\u0434\u044a\u0451\u043c\u043d\u043e\u0441\u0442\u044c \u0434\u043e 130 \u043a\u0433, \u0435\u0441\u0442\u044c \u0433\u0440\u0443\u0437\u043e\u0432\u0430\u044f \u043b\u0435\u0431", "snippet_en": "\u041f\u0435\u0440\u0432\u0430\u044f \u0432 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u044d\u0432\u0430\u043a\u0443\u0430\u0446\u0438\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0411\u041f\u041b\u0410. \u0425\u043e\u0445\u043b\u044b \u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b\u0438 \u0434\u0440\u043e\u043d \u0434\u043b\u044f \u044d\u0432\u0430\u043a\u0443\u0430\u0446\u0438\u0438 \u0440\u0430\u043d\u0435\u043d\u044b\u0445. \u0411\u043e\u0435\u0446 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0440\u0430\u043d\u0435\u043d\u0438\u044f \u043e\u0431\u0435\u0438\u0445 \u043d\u043e\u0433 14 \u0444\u0435\u0432\u0440\u0430\u043b\u044f 2026 \u0433\u043e\u0434\u0430 \u0432 \u0441\u0435\u0440\u043e\u0439 \u0437\u043e\u043d\u0435 \u0443 \u0440\u0435\u043a\u0438 \u041e\u0441\u043a\u043e\u043b \u0438 \u0438\u0437\u2011\u0437\u0430 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0432\u044b\u0445\u043e\u0434\u0430 \u043f\u043e \u0437\u0435\u043c\u043b\u0435 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u043d\u0430 \u043f\u043e\u0437\u0438\u0446\u0438\u0438 \u0434\u043e 4 \u043e\u043a\u0442\u044f\u0431\u0440\u044f (\u0435\u043c\u0443 \u0440\u0430\u0437 \u0432 4\u20135 \u0434\u043d\u0435\u0439 \u0441\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u043b\u0438 \u043f\u0440\u0438\u043f\u0430\u0441\u044b \u0434\u0440\u043e\u043d\u0430\u043c\u0438). \u0414\u043b\u044f \u044d\u0432\u0430\u043a\u0443\u0430\u0446\u0438\u0438 \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u0442\u044f\u0436\u0451\u043b\u044b\u0439 \u0431\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u0438\u043a Heavy Shot \u0410\u044e\u0434\u0430\u0433\u20116 (\u0433\u0440\u0443\u0437\u043e\u043f\u043e\u0434\u044a\u0451\u043c\u043d\u043e\u0441\u0442\u044c \u0434\u043e 130 \u043a\u0433, \u0435\u0441\u0442\u044c \u0433\u0440\u0443\u0437\u043e\u0432\u0430\u044f \u043b\u0435\u0431", "link": "https://t.me/VictoryDrones/67326", "pubDate": "2026-10-21T12:12:47+00:00"}, {"channel": "wartranslated", "snippet": "Ukrainian soldiers have become the first in the world to evacuate a wounded fighter from the front line using an aerial drone. The 92nd Assault Brigade reported. They deployed a heavy hexacopter manufactured by Ukraine's Gurzuf Defence. The operation was successful. The wounded infantryman from the 30th Mechanized Brigade is currently undergoing medical treatment and rehabilitation. If our transla", "snippet_en": "Ukrainian soldiers have become the first in the world to evacuate a wounded fighter from the front line using an aerial drone. The 92nd Assault Brigade reported. They deployed a heavy hexacopter manufactured by Ukraine's Gurzuf Defence. The operation was successful. The wounded infantryman from the 30th Mechanized Brigade is currently undergoing medical treatment and rehabilitation. If our transla", "link": "https://t.me/wartranslated/19638", "pubDate": "2026-10-20T21:30:31+00:00"}, {"channel": "wartranslated", "snippet": "Running away, the cat warned the Ukrainian FPV drone operator of the approaching Russians.", "snippet_en": "Running away, the cat warned the Ukrainian FPV drone operator of the approaching Russians.", "link": "https://t.me/wartranslated/19635", "pubDate": "2026-10-20T18:18:52+00:00"}, {"channel": "lost_armour", "snippet": "\u0425\u043b\u0430\u0434\u043d\u043e\u043a\u0440\u043e\u0432\u0438\u0435 \u0438 \u0432\u044b\u0434\u0435\u0440\u0436\u043a\u0430 \u043e\u043f\u044b\u0442\u043d\u043e\u0433\u043e \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 FPV-\u0434\u0440\u043e\u043d\u0430. \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043d\u043e\u0432\u0438\u0447\u043a\u0430, \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u0437\u0432\u0430\u0442\u044c \u0440\u0435\u0437\u043a\u0438\u0439 \u0432\u044b\u0431\u0440\u043e\u0441 \u0430\u0434\u0440\u0435\u043d\u0430\u043b\u0438\u043d\u0430, \u043e\u043f\u044b\u0442\u043d\u044b\u0439 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u0438\u0435 \u0434\u0430\u0436\u0435 \u0432 \u043d\u0430\u043f\u0440\u044f\u0436\u0451\u043d\u043d\u043e\u0439 \u043e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435. \u0417\u0430\u043c\u0435\u0442\u0438\u0432 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0443\u044e \u0442\u0435\u0445\u043d\u0438\u043a\u0443, \u043e\u043d \u043d\u0435 \u0441\u0442\u0430\u043b \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u043f\u043e\u0441\u043f\u0435\u0448\u043d\u043e. \u041d\u0430\u043f\u0440\u043e\u0442\u0438\u0432, \u0432\u0437\u044f\u043b \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043f\u0430\u0443\u0437\u0443, \u0447\u0442\u043e\u0431\u044b \u0432\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u0435\u0435 \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e. \u041f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0432\u0448\u0438\u0441\u044c \u043a \u043c\u0430\u0448\u0438\u043d\u0435, \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043e\u0442\u043a", "snippet_en": "\u0425\u043b\u0430\u0434\u043d\u043e\u043a\u0440\u043e\u0432\u0438\u0435 \u0438 \u0432\u044b\u0434\u0435\u0440\u0436\u043a\u0430 \u043e\u043f\u044b\u0442\u043d\u043e\u0433\u043e \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 FPV-\u0434\u0440\u043e\u043d\u0430. \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u043d\u043e\u0432\u0438\u0447\u043a\u0430, \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u043e\u0439 \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u0437\u0432\u0430\u0442\u044c \u0440\u0435\u0437\u043a\u0438\u0439 \u0432\u044b\u0431\u0440\u043e\u0441 \u0430\u0434\u0440\u0435\u043d\u0430\u043b\u0438\u043d\u0430, \u043e\u043f\u044b\u0442\u043d\u044b\u0439 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u0438\u0435 \u0434\u0430\u0436\u0435 \u0432 \u043d\u0430\u043f\u0440\u044f\u0436\u0451\u043d\u043d\u043e\u0439 \u043e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435. \u0417\u0430\u043c\u0435\u0442\u0438\u0432 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0443\u044e \u0442\u0435\u0445\u043d\u0438\u043a\u0443, \u043e\u043d \u043d\u0435 \u0441\u0442\u0430\u043b \u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u043f\u043e\u0441\u043f\u0435\u0448\u043d\u043e. \u041d\u0430\u043f\u0440\u043e\u0442\u0438\u0432, \u0432\u0437\u044f\u043b \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043f\u0430\u0443\u0437\u0443, \u0447\u0442\u043e\u0431\u044b \u0432\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u0435\u0435 \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e. \u041f\u0440\u0438\u0431\u043b\u0438\u0437\u0438\u0432\u0448\u0438\u0441\u044c \u043a \u043c\u0430\u0448\u0438\u043d\u0435, \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440 \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043e\u0442\u043a", "link": "https://t.me/lost_armour/11884", "pubDate": "2026-10-20T17:54:21+00:00"}, {"channel": "lost_armour", "snippet": "\ud83d\udd34 \u0413\u043e\u0440\u044f\u0447\u0430\u044f \u043e\u0441\u0435\u043d\u044c \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u0430\" \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043d\u0430\u043b\u043e\u043c \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043e \u0441\u0432\u044b\u0448\u0435 55 000 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u0431\u043e\u0435\u0432\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u043f\u043e\u0434\u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f. \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430* \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439 (\u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447) \u043f\u043e \u0442\u0438\u043f\u0430\u043c: (*\u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0442\u0441\u0435\u0447\u043a\u0438 \u0432 50 000 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439) 49,7% (+2.8%) - \u0411\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u044b\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432 \u0442.\u0447: \u2022 29,0% (+0,2%) - \u043c\u0443\u043b\u044c\u0442\u0438\u043a\u043e\u043f\u0442\u0435\u0440\u044b \u2022 15,0% (+2,5%) - \u0441\u0430\u043c\u043e\u043b\u0435\u0442\u043d\u044b\u0439 \u0442\u0438\u043f \u2022 5,7% (+0.1%) - \u041d\u0420\u0422\u041a 12,8% (-0,7%", "snippet_en": "\ud83d\udd34 \u0413\u043e\u0440\u044f\u0447\u0430\u044f \u043e\u0441\u0435\u043d\u044c \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\u0430\" \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043a\u