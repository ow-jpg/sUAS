\u043a\u043e\u0432\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c. \u041d\u0430\u0448\u0438 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b FPV-\u0434\u0440\u043e\u043d\u043e\u0432 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442 \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430 \u0425\u0430\u0440\u044c\u043a\u043e\u0432\u0441\u043a\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438. \u0412 \u0446\u0435\u043d\u0442\u0440\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u2014 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442 \u0412\u0421\u0423 \u0438 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u044b, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0435 \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0442\u0435\u0445\u043d\u0438\u043a\u0438. 00:49 \u041e\u0434\u0438\u043d \u0438\u0437 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u041f\u0438\u043a\u0430\u043f\u0443 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0442\u043e\u0440\u0432\u0430\u0442\u044c\u0441\u044f \u043e\u0442 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0432\u0448\u0435\u0433\u043e \u0435\u0433\u043e \u0434\u0440\u043e\u043d\u0430. \u0425\u043e\u0440\u043e\u0448\u0435\u0435 \u0434\u043e\u0440\u043e\u0436\u043d\u043e\u0435 \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u0435 \u0438 \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0441\u044b\u0433\u0440\u0430\u043b\u0438 \u0441\u0432\u043e\u044e \u0440\u043e\u043b\u044c. 01:14 \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u043f\u0435\u0440\u0430\u0442", "snippet_en": "\ud83d\udd3b\u0425\u0430\u0440\u044c\u043a\u043e\u0432\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c. \u041d\u0430\u0448\u0438 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b FPV-\u0434\u0440\u043e\u043d\u043e\u0432 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442 \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430 \u0425\u0430\u0440\u044c\u043a\u043e\u0432\u0441\u043a\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438. \u0412 \u0446\u0435\u043d\u0442\u0440\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u2014 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442 \u0412\u0421\u0423 \u0438 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u044b, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0435 \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0442\u0435\u0445\u043d\u0438\u043a\u0438. 00:49 \u041e\u0434\u0438\u043d \u0438\u0437 \u044d\u043f\u0438\u0437\u043e\u0434\u043e\u0432 \u043e\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u0440\u0438\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u041f\u0438\u043a\u0430\u043f\u0443 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0442\u043e\u0440\u0432\u0430\u0442\u044c\u0441\u044f \u043e\u0442 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0432\u0448\u0435\u0433\u043e \u0435\u0433\u043e \u0434\u0440\u043e\u043d\u0430. \u0425\u043e\u0440\u043e\u0448\u0435\u0435 \u0434\u043e\u0440\u043e\u0436\u043d\u043e\u0435 \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u0435 \u0438 \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0441\u044b\u0433\u0440\u0430\u043b\u0438 \u0441\u0432\u043e\u044e \u0440\u043e\u043b\u044c. 01:14 \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u043f\u0435\u0440\u0430\u0442", "link": "https://t.me/lost_armour/12253", "pubDate": "2026-11-16T06:59:59+00:00"}, {"channel": "VictoryDrones2023", "snippet": "\u041d\u043e\u0432\u0438\u0439 \u0433\u0430\u0439\u0434 \u043f\u043e \u043a\u043e\u043d\u0442\u0440-OSINT \u0432\u0456\u0434 Victory Drones&#33; \u0414\u043e\u043f\u043e\u0432\u043d\u0438\u043b\u0438 \u043d\u0430\u0448\u0443 \u0431\u0430\u0437\u0443 \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0438\u0445 \u043f\u043b\u0430\u043a\u0430\u0442\u0456\u0432 \u043d\u043e\u0432\u0438\u043c \u043f\u043e\u0440\u0430\u0434\u043d\u0438\u043a\u043e\u043c \u2014 \u044f\u043a \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u043e \u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0444\u043e\u0442\u043e \u0432 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442. \ud83d\udccc \u0412\u0430\u0436\u043b\u0438\u0432\u043e: \u2022 \u041f\u043b\u0430\u043a\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456 \u0443 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u043c\u0443 \u0444\u043e\u0440\u043c\u0430\u0442\u0456 \u0442\u0430 \u0432\u0436\u0435 \u0433\u043e\u0442\u043e\u0432\u0456 \u0434\u043e \u0434\u0440\u0443\u043a\u0443. \u2022 \u0422\u0435\u043c\u0430 OSINT \u043e\u0444\u0456\u0446\u0456\u0439\u043d\u043e \u0454 \u0447\u0430\u0441\u0442\u0438\u043d\u043e\u044e \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0438\u0445 \u043f\u0440\u043e\u0433\u0440\u0430\u043c \u00ab\u0417\u0430\u0445\u0438\u0441\u0442\u0443 \u0423\u043a\u0440\u0430\u0457\u043d\u0438\u00bb \u0442\u0430 \u041f\u0440\u043e\u0433\u0440\u0430\u043c \u0437 \u043f\u0456\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u0433\u0440\u043e\u043c\u0430\u0434\u044f\u043d \u0434\u043e \u043d\u0430\u0446\u0456\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043f\u0440\u043e\u0442\u0438\u0432\u0443. \u0421\u043f\u043e\u0434\u0456\u0432\u0430\u0454\u043c\u043e\u0441\u044c, \u0446\u0456 \u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b\u0438 \u0441\u0442\u0430\u043d\u0443\u0442\u044c \u043d\u0430\u0434\u0456\u0439\u043d\u0438\u043c \u043f\u043e", "snippet_en": "\u041d\u043e\u0432\u0438\u0439 \u0433\u0430\u0439\u0434 \u043f\u043e \u043a\u043e\u043d\u0442\u0440-OSINT \u0432\u0456\u0434 Victory Drones&#33; \u0414\u043e\u043f\u043e\u0432\u043d\u0438\u043b\u0438 \u043d\u0430\u0448\u0443 \u0431\u0430\u0437\u0443 \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0438\u0445 \u043f\u043b\u0430\u043a\u0430\u0442\u0456\u0432 \u043d\u043e\u0432\u0438\u043c \u043f\u043e\u0440\u0430\u0434\u043d\u0438\u043a\u043e\u043c \u2014 \u044f\u043a \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u043e \u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0444\u043e\u0442\u043e \u0432 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442. \ud83d\udccc \u0412\u0430\u0436\u043b\u0438\u0432\u043e: \u2022 \u041f\u043b\u0430\u043a\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456 \u0443 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u043c\u0443 \u0444\u043e\u0440\u043c\u0430\u0442\u0456 \u0442\u0430 \u0432\u0436\u0435 \u0433\u043e\u0442\u043e\u0432\u0456 \u0434\u043e \u0434\u0440\u0443\u043a\u0443. \u2022 \u0422\u0435\u043c\u0430 OSINT \u043e\u0444\u0456\u0446\u0456\u0439\u043d\u043e \u0454 \u0447\u0430\u0441\u0442\u0438\u043d\u043e\u044e \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0438\u0445 \u043f\u0440\u043e\u0433\u0440\u0430\u043c \u00ab\u0417\u0430\u0445\u0438\u0441\u0442\u0443 \u0423\u043a\u0440\u0430\u0457\u043d\u0438\u00bb \u0442\u0430 \u041f\u0440\u043e\u0433\u0440\u0430\u043c \u0437 \u043f\u0456\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u0433\u0440\u043e\u043c\u0430\u0434\u044f\u043d \u0434\u043e \u043d\u0430\u0446\u0456\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043f\u0440\u043e\u0442\u0438\u0432\u0443. \u0421\u043f\u043e\u0434\u0456\u0432\u0430\u0454\u043c\u043e\u0441\u044c, \u0446\u0456 \u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b\u0438 \u0441\u0442\u0430\u043d\u0443\u0442\u044c \u043d\u0430\u0434\u0456\u0439\u043d\u0438\u043c \u043f\u043e", "link": "https://t.me/VictoryDrones2023/29006", "pubDate": "2026-11-15T22:55:01+00:00"}, {"channel": "serhii_flash", "snippet": "\u041a\u0456\u043b\u044c\u043a\u0430 \u0440\u043e\u043a\u0456\u0432 \u043c\u043e\u0457 \u043a\u043e\u043b\u0435\u0433\u0438-\u0432\u0456\u0439\u0441\u044c\u043a\u043e\u0432\u0456 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u043b\u0438 \u043c\u0435\u043d\u0456 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0456\u0457 \u0437 \u0411\u041f\u041b\u0410 \u0434\u043b\u044f \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u0457. \u0420\u041b\u0421, \u0420\u0415\u0411, \u0437\u0432\u2019\u044f\u0437\u043e\u043a. \u0411\u0443\u0432\u0430\u043b\u043e, \u044f \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0432 \u043f\u043e 30 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0456\u0439 \u043d\u0430 \u0434\u0435\u043d\u044c. \u0410 \u0437\u0430\u0440\u0430\u0437 \u0446\u0435\u0439 \u043f\u043e\u0442\u0456\u043a \u0437\u043c\u0435\u043d\u0448\u0438\u0432\u0441\u044f \u0434\u043e 1\u20132 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0456\u0439 \u043d\u0430 \u0434\u0435\u043d\u044c. \u042f\u043a \u0432\u0438 \u0432\u0432\u0430\u0436\u0430\u0454\u0442\u0435, \u0446\u0435 \u0442\u043e\u043c\u0443, \u0449\u043e \u0443 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u043d\u0435\u043c\u0430\u0454 \u043d\u043e\u0432\u0438\u0445 \u0437\u0440\u0430\u0437\u043a\u0456\u0432, \u0430 \u0441\u0442\u0430\u0440\u0456 \u0432\u0436\u0435 \u0432\u0441\u0456 \u043d\u0430\u0432\u0447\u0438\u043b\u0438\u0441\u044f \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u0442\u0438?", "snippet_en": "\u041a\u0456\u043b\u044c\u043a\u0430 \u0440\u043e\u043a\u0456\u0432 \u043c\u043e\u0457 \u043a\u043e\u043b\u0435\u0433\u0438-\u0432\u0456\u0439\u0441\u044c\u043a\u043e\u0432\u0456 \u04