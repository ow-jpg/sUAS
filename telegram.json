2\u0440\u0456\u043b\u0456\u0432 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u0445 \u043f\u0443\u043d\u043a\u0442\u0456\u0432 \u0456 \u043f\u043e\u0437\u0438\u0446\u0456\u0439 \u043d\u0430\u0448\u0438\u0445 \u0432\u0456\u0439\u0441\u044c\u043a. \u0423\u043f\u0440\u043e\u0434\u043e\u0432\u0436 \u0434\u043e\u0431\u0438 \u043d\u0430 \u041f\u0456\u0432\u0434\u0435\u043d\u043d\u043e-\u0421\u043b\u043e\u0431\u043e\u0436\u0430\u043d\u0441\u044c\u043a\u043e\u043c\u0443 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a 9 \u0440\u0430\u0437\u0456\u0432 \u0448\u0442\u0443\u0440\u043c\u0443\u0432\u0430\u0432 \u043f\u043e\u0437\u0438\u0446\u0456\u0457 \u043d\u0430\u0448\u0438\u0445 \u043f\u0456\u0434\u0440", "snippet_en": "\ud83d\udcaa \u041f\u043e\u043d\u0430\u0434 200 \u0431\u043e\u0454\u0437\u0456\u0442\u043a\u043d\u0435\u043d\u044c \u0437\u0430\u0444\u0456\u043a\u0441\u043e\u0432\u0430\u043d\u043e \u043d\u0430 \u0444\u0440\u043e\u043d\u0442\u0456, \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0435 - \u043d\u0430 \u041f\u043e\u043a\u0440\u043e\u0432\u0441\u044c\u043a\u043e\u043c\u0443 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443, - \u0413\u0435\u043d\u0448\u0442\u0430\u0431 \u041f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a \u0437\u0430\u0432\u0434\u0430\u0432 \u0434\u0432\u043e\u0445 \u0440\u0430\u043a\u0435\u0442\u043d\u0438\u0445 \u0443\u0434\u0430\u0440\u0456\u0432, \u0437\u0434\u0456\u0439\u0441\u043d\u0438\u0432 63 \u0430\u0432\u0456\u0430\u0446\u0456\u0439\u043d\u0456 \u0443\u0434\u0430\u0440\u0438, \u0441\u043a\u0438\u043d\u0443\u0432 228 \u043a\u0435\u0440\u043e\u0432\u0430\u043d\u0438\u0445 \u0430\u0432\u0456\u0430\u0431\u043e\u043c\u0431. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0437\u0430\u043b\u0443\u0447\u0438\u0432 6477 \u0434\u0440\u043e\u043d\u0456\u0432-\u043a\u0430\u043c\u0456\u043a\u0430\u0434\u0437\u0435 \u0442\u0430 \u0437\u0434\u0456\u0439\u0441\u043d\u0438\u0432 2046 \u043e\u0431\u0441\u0442\u0440\u0456\u043b\u0456\u0432 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u0445 \u043f\u0443\u043d\u043a\u0442\u0456\u0432 \u0456 \u043f\u043e\u0437\u0438\u0446\u0456\u0439 \u043d\u0430\u0448\u0438\u0445 \u0432\u0456\u0439\u0441\u044c\u043a. \u0423\u043f\u0440\u043e\u0434\u043e\u0432\u0436 \u0434\u043e\u0431\u0438 \u043d\u0430 \u041f\u0456\u0432\u0434\u0435\u043d\u043d\u043e-\u0421\u043b\u043e\u0431\u043e\u0436\u0430\u043d\u0441\u044c\u043a\u043e\u043c\u0443 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a 9 \u0440\u0430\u0437\u0456\u0432 \u0448\u0442\u0443\u0440\u043c\u0443\u0432\u0430\u0432 \u043f\u043e\u0437\u0438\u0446\u0456\u0457 \u043d\u0430\u0448\u0438\u0445 \u043f\u0456\u0434\u0440", "link": "https://t.me/VictoryDrones2023/28544", "pubDate": "2026-09-12T19:45:50+00:00"}, {"channel": "lost_armour", "snippet": "\u0421\u0442\u0438\u0445\u0438\u044f \u00ab\u0401\u043b\u043a\u0438\u00bb \u2013 \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442 \ud83e\udd16 \u041d\u0430 \u0441\u0442\u0440\u0430\u0436\u0435 \u043d\u0430\u0448\u0438\u0445 \u043f\u043e\u0437\u0438\u0446\u0438\u0439 \u2013 \u0434\u0440\u043e\u043d-\u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043a \u00ab\u0401\u043b\u043a\u0430\u00bb. \u042d\u0442\u043e\u0442 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441 \u043d\u0430\u0445\u043e\u0434\u0438\u0442, \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0438 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0430\u0435\u0442 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0435 \u0411\u041f\u041b\u0410. \u26a1\ufe0f \u041c\u043e\u043b\u043d\u0438\u0435\u043d\u043e\u0441\u043d\u044b\u0439 \u0442\u0430\u0440\u0430\u043d: \u043f\u0440\u0438 \u0432\u0435\u0441\u0435 \u0432\u0441\u0435\u0433\u043e 1,3 \u043a\u0438\u043b\u043e\u0433\u0440\u0430\u043c\u04