44c\u0442\u0438\u043a\u043e\u043f\u0442\u0435\u0440\u043e\u0432 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430 \u0434\u043e\u043b\u0435\u0439 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0442\u0441\u0435\u0447\u043a\u0438 \u0432 9000 \u0435\u0434\u0438\u043d\u0438\u0446: \u2022 73,8% (-1,5%) - \u0422\u044f\u0436\u0435\u043b\u044b\u0435 \u043c\u0443\u043b\u044c\u0442\u0438\u043a\u043e\u043f\u0442\u0435\u0440\u044b (\u0442.\u043d. \"\u0411\u0430\u0431\u0430-\u042f\u0433\u0430\") \u2022 15,7% - \u041b\u0435\u0433\u043a\u0438\u0435 \u043c\u0443\u043b\u044c\u0442\u0438\u043a\u043e\u043f\u0442\u0435\u0440\u044b (Mavic, Matrice, Autel \u0438 \u043f\u0440.) \u2022 8,7% (+1,4%) - FPV-\u0434\u0440\u043e\u043d\u044b \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430", "snippet_en": "\ud83d\udd34 \u0421\u0447\u0435\u0442 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u043a\u0438 \u0442\u044b\u0441\u044f\u0447 \u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u043f\u043e\u0440\u0430\u0437\u0438\u043b\u0438 \u0441\u0432\u044b\u0448\u0435 10000 \u043c\u0443\u043b\u044c\u0442\u0438\u043a\u043e\u043f\u0442\u0435\u0440\u043e\u0432 \u0412\u0421\u0423, \u0438\u0437 \u043d\u0438\u0445 \u0431\u043e\u043b\u0435\u0435 1200 - \u0437\u0430 \u0438\u044e\u043b\u044c 2026 \u0433\u043e\u0434\u0430. \u0420\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u043e \u0442\u0438\u043f\u0430\u043c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u043d\u044b\u0445 \u043c\u0443\u043b\u044c\u0442\u0438\u043a\u043e\u043f\u0442\u0435\u0440\u043e\u0432 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430 \u0434\u043e\u043b\u0435\u0439 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0442\u044