43e\u0437\u043f\u0456\u0437\u043d\u0430\u0442\u0438 \u043d\u0435\u0431\u0435\u0437\u043f\u0435\u043a\u0443 \u0432\u0447\u0430\u0441\u043d\u043e? \u0429\u043e \u0440\u043e\u0431\u0438\u0442\u0438, \u044f\u043a\u0449\u043e \u0431\u0430\u0447\u0438\u0442\u0435, \u0447\u0443\u0454\u0442\u0435 \u0434\u0440\u043e\u043d, \u0447\u0438 \u043f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u0439\u043e\u0433\u043e \u0441\u0445\u043e\u0432\u0430\u043d\u043a\u0443? \u0414\u0438\u0432\u0456\u0442\u044c\u0441\u044f \u0443 \u0432\u0456\u0434\u0435\u043e \u0456\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0456\u0457, \u0449\u043e\u0431 \u0437\u043d\u0430\u0442\u0438, \u044f\u043a \u0434\u0456\u044f\u0442\u0438 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0430\u0442\u0430\u043a\u0438 \u0434\u0440\u043e\u043d\u0430 \u0432 \u043c\u0456\u0441\u0442\u0456, \u043d\u0430 \u0442\u0440\u0430\u0441\u0456 \u0447\u0438 \u0410\u0417\u0421. \u231a20 \u0445\u0432 - https://www.youtube.", "snippet_en": "\u0426\u0435 \u0432\u0456\u0434\u0435\u043e \u043c\u0430\u044e\u0442\u044c \u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e \u043f\u043e\u0441\u043b\u0443\u0445\u0430\u0442\u0438, \u043f\u043e\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044c \u0432\u0441\u0456 \u0446\u0438\u0432\u0456\u043b\u044c\u043d\u0456, \u0449\u043e \u0436\u0438\u0432\u0443\u0442\u044c \u0432 \u0423\u043a\u0440\u0430\u0457\u043d\u0456, \u043e\u0441\u043e\u0431\u043b\u0438\u0432\u043e \u0443 \u043f\u0440\u0438\u0444\u0440\u043e\u043d\u0442\u043e\u0432\u0438\u0445 \u043c\u0456\u0441\u0442\u0430\u0445 \u042f\u043a \u0446\u0438\u0432\u0456\u043b\u044c\u043d\u0438\u043c \u0443\u0431\u0435\u0440\u0435\u0433\u0442\u0438\u0441\u044f \u0432\u0456\u0434 \u0430\u0442\u0430\u043a\u0438 FPV? \u042f\u043a\u0456 \u0456\u0441\u043d\u0443\u044e\u0442\u044c \u0432\u0438\u0434\u0438 \u0434\u0440\u043e\u043d\u0456\u0432 \u0442\u0430 \u044f\u043a \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0442\u0438 \u043d\u0435\u0431\u0435\u0437\u043f\u04