044b\u0441\u043e\u043a\u043e\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u043a\u0430\u043d\u0430\u043b\u0430 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0434\u0430\u043d\u043d\u044b\u0445 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0430 5G \u0441\u043e \u0441\u0442\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u0440\u043d\u043e\u0439 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u044b. \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u0438\u043c\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0430\u043c\u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0438\u044f \u0432\u0438\u0434\u0435\u043e\u043f\u043e\u0442\u043e\u043a\u0430 \u0432 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0438 2K \u043c\u0435\u0436\u0434\u0443 \u0431\u0435\u0441\u043f\u0438\u043b\u043e\u0442\u043d\u044b\u043c \u0441\u0442\u0440\u0430\u0442\u043e\u0441\u0442\u0430\u0442\u043e\u043c, \u043d\u0430\u0445\u043e\u0434\u044f\u0449\u0438\u043c\u0441\u044f \u043d\u0430 \u044d\u0448\u0435\u043b\u043e\u043d\u0435 17 \u043a\u043c, \u0438 \u043d\u0430\u0437\u0435\u043c\u043d\u044b\u043c \u043f\u0443\u043d\u043a\u0442\u043e\u043c \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f. \u0421\u0435\u0430\u043d\u0441 \u0441\u0432\u044f\u0437\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b\u0441\u044f \u0431\u043e\u043b\u0435\u0435 80 \u043c\u0438\u043d\u0443\u0442, \u0447\u0442\u043e \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b\u043e \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u0440\u0438\u0451\u043c\u043e-\u043f\u0435\u0440\u0435\u0434\u0430\u044e\u0449\u0435\u0439 \u0430\u043f", "snippet_en": "\u0412 \u0420\u043e\u0441\u0441\u0438\u0438 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d \u044d\u043a\u0441\u043f\u0435\u0440\u0438