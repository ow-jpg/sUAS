e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u043e\u0439 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b 04:16 - \u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0412\u0421\u0423 04:46 - \u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 FPV-\u0434\u0440\u043e\u043d\u043e\u0432 \u0441 \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u044b\u0445 \u043d\u043e\u0441\u0438\u0442\u0435\u043b\u0435\u0439 05:22 - \u0421\u0431\u0440\u043e\u0441\u044b \u0438 \u0443\u0434\u0430\u0440\u044b \u043f\u043e \u0446\u0435\u043b\u044f\u043c \u0412\u0421\u0423 05:55 - \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0441\u043a\u043b\u0430\u0434", "snippet_en": "\u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0437\u0430 17 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 2026 \u0433\u043e\u0434\u0430 00:05 - \u0414\u043e\u043d\u0431\u0430\u0441\u0441 01:39 - \u041a\u0440\u0430\u0441\u043d\u043e\u043b\u0438\u043c\u0430\u043d\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 02:20 - \u0421\u0443\u043c\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 03:00 - \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u0435\u0445\u043e\u0442\u044b \u0412\u0421\u0423 03:57 - \u041f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u043e\u0439 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u044b 04:16 - \u0