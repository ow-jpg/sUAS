a\u043e\u043d\u043d\u043e\u0433\u043e FPV-\u0434\u0440\u043e\u043d\u0430 \"\u041a\u0412\u041d\" \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d \u0442\u044f\u0436\u0435\u043b\u044b\u0439 \u041d\u0420\u0422\u041a \"Protector\" \u0412\u0421\u0423. \u041d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0438\u0439 \u0434\u0435\u043d\u044c \u044d\u0442\u043e \u0441\u0430\u043c\u044b\u0439 \u043a\u0440\u0443\u043f\u043d\u044b\u0439 \u041d\u0420\u0422\u041a \u0412\u0421\u0423 \u0441 \u0433\u0440\u0443\u0437\u043e\u043f\u043e\u0434\u044a\u0435\u043c\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e 1,5\u0442, \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c\u044b\u0439 \u0432 \u0447\u0430\u0441\u0442\u0438 \u041d\u0413\u0423 \u0438 \u0421\u0411\u0421 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0435\u0439 Ukrainian\u2026", "link": "https://t.me/lost_armour/11918", "pubDate": "2026-10-23T10:53:04+00:00"}, {"channel": "lost_armour", "snippet": "\u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0437\u0430 22 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 2026 \u0433\u043e\u0434\u0430 00:05 - \u0414\u043e\u043d\u0431\u0430\u0441\u0441 02:38 - \u041a\u0440\u0430\u0441\u043d\u043e\u043b\u0438\u043c\u0430\u043d\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 03:11 - \u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0412\u0421\u0423 04:02 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 05:34 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u043e\u0447\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 06:06 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0434\u0430\u043b\u044c\u043d\u043e\u0431\u043e\u0439\u043d\u044b\u043c \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 08:42 - \u0423\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d\u0438\u0435 155-\u043c\u043c \u0421\u0410\u0423 \"Caesar\"", "snippet_en": "\u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432 \u0426\u0435\u043d\u0442\u0440\u0430 \"\u0420\u0443\u0431\u0438\u043a\u043e\u043d\" \u0437\u0430 22 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 2026 \u0433\u043e\u0434\u0430 00:05 - \u0414\u043e\u043d\u0431\u0430\u0441\u0441 02:38 - \u041a\u0440\u0430\u0441\u043d\u043e\u043b\u0438\u043c\u0430\u043d\u0441\u043a\u043e\u0435 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 03:11 - \u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 \u0412\u0421\u0423 04:02 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 05:34 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u043e\u0447\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 06:06 - \u0411\u043e\u0435\u0432\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 FPV-\u041f\u0412\u041e \u043f\u043e \u0434\u0430\u043b\u044c\u043d\u043e\u0431\u043e\u0439\u043d\u044b\u043c \u0411\u041f\u041b\u0410 \u0412\u0421\u0423 08:42 - \u0423\u043d\u0438\u0447\u0442\u043e\u0436\u0435\u043d\u0438\u0435 155-\u043c\u043c \u0421\u0410\u0423 \"Caesar\"", "link": "https://t.me/lost_armour/11907", "pubDate": "2026-10-22T11:10:01+00:00"}, {"channel": "lost_armour", "snippet": "\u0411\u0430\u0440\u0440\u0430\u0436\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0431\u043e\u0435\u043f\u0440\u0438\u043f\u0430\u0441 \"\u041b\u0430\u043d\u0446\u0435\u0442\" \u043d\u0430\u043d\u043e\u0441\u0438\u0442 \u0443\u0434\u0430\u0440 \u043f\u043e \u0430\u0432\u0442\u043e\u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0443 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430, \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u044e\u0449\u0435\u043c\u0443 \u043f\u043e\u0434\u0432\u043e\u0437 \u043a \u043f\u0443\u043d\u043a\u0442\u0443 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0411\u041f\u041b\u0410 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0432 \u0414\u043d\u0435\u043f\u0440\u043e\u043f\u0435\u0442\u0440\u043e\u0432\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438. \u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0442 26 \u041e\u0411\u0440\u0411\u043f\u0421. \ud83d\udccd\u0413\u0435\u043e\u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0430 \u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \"\u041b\u0430\u043d\u0446\u0435\u0442\u043e\u0432\": https://lostarmour.info/tags/lancet \ud83d\udd39 \u041c\u044b \u0432 MAX", "snippet_en": "\u0411\u0430\u0440\u0440\u0430\u0436\u0438\u0440\u0443\u044e\u0449\u0438\u0439 \u0431\u043e\u0435\u043f\u0440\u0