56\u0441\u0442\u044e \u0434\u043e 200 \u043a\u043c/\u0433\u043e\u0434", "snippet_en": "\u041a\u043e\u043b\u0438 \u0432\u0441\u0456 \u0431\u0430\u0447\u0430\u0442\u044c \u0432\u0456\u0437\u0443\u0430\u043b\u044c\u043d\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0440\u043e\u0431\u043e\u0442\u0438 \u043d\u0430\u0448\u0438\u0445 \u0431\u0435\u0437\u043f\u0456\u043b\u043e\u0442\u043d\u0438\u043a\u0456\u0432, \u044f \u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u0430\u043c\u0438\u0441\u043b\u044e\u044e\u0441\u044f \u043d\u0430\u0434 \u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u0439\u043d\u043e-\u0442\u0435\u0445\u043d\u0456\u0447\u043d\u043e\u044e \u0447\u0430\u0441\u0442\u0438\u043d\u043e\u044e. \u0429\u043e\u0431 \u0434\u043e\u043b\u0435\u0442\u0456\u0442\u0438 \u0434\u043e \u041f\u0456\u0442\u0435\u0440\u0430, \u043d\u0430\u0448\u0438\u043c \u0411\u041f\u041b\u0410 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u043f\u043e\u0434\u043e\u043b\u0430\u0442\u0438 1000 \u043a\u043c \u0447\u0435\u0440\u0435\u0437 4 \u043e\u0431\u043b\u0430\u0441\u0442\u0456 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430. 4 \u043e\u0431\u043b\u0430\u0441\u0442\u0456, \u044f\u043a\u0456 \u0437\u0430\u0445\u0438\u0449\u0435\u043d\u0456 \u041f\u041f\u041e \u0442\u0430 \u0420\u0415\u0411. \u041f\u0440\u0438\u0447\u043e\u043c\u0443 \u0446\u0435 \u043d\u0435 \u043a\u0440\u0438\u043b\u0430\u0442\u0456 \u0440\u0430\u043a\u0435\u0442\u0438 \u0437 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0438\u043c\u0438 \u0441\u0456\u0441\u0442\u0435\u043c\u0430\u043c\u0438, \u0446\u0435 \u0411\u041f\u041b\u0410, \u044f\u043a\u0456 \u043b\u0435\u0442\u044f\u0442\u044c \u0437\u0456 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044e \u0434\u043e 200 \u043a\u043c/\u0433\u043e\u0434", "link": "https://t.me/serhii_flash/7817", "pubDate": "2026-10-18T09:03:40+00:00"}, {"channel": "VictoryDrones2023", "snippet": "\ud83d\udcaa \u041f\u041f\u041e \u0437\u043d\u0435\u0448\u043a\u043e\u0434\u0438\u043b\u0430 140 \u0437\u0456 157 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0411\u043f\u041b\u0410 \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0434\u043d\u044f, - \u041f\u043e\u0432\u0456\u0442\u0440\u044f\u043d\u0456 \u0441\u0438\u043b\u0438 \u041f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0434\u043d\u044f 17 \u0436\u043e\u0432\u0442\u043d\u044f (\u0456\u0437 7:30 \u043f\u043e 19:30) \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a \u0430\u0442\u0430\u043a\u0443\u0432\u0430\u0432 \u0423\u043a\u0440\u0430\u0457\u043d\u0443 157 \u0443\u0434\u0430\u0440\u043d\u0438\u043c\u0438 \u0411\u043f\u041b\u0410 (25 \u0456\u0437 \u043d\u0438\u0445 - \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u0456), \u0413\u0435\u0440\u0431\u0435\u0440\u0430 \u0442\u0430 \u0434\u0440\u043e\u043d\u0430\u043c\u0438 \u0456\u043d\u0448\u0438\u0445 \u0442\u0438\u043f\u0456\u0432, \u0430 \u0442\u0430\u043a\u043e\u0436 6-\u043c\u0430 S-8000 \u0411\u0430\u043d\u0434\u0435\u0440\u043e\u043b\u044c/\u0414\u0430\u043d\u044c-\u0422. \u0417\u0430 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u043c\u0438 \u0434\u0430\u043d\u0438\u043c\u0438, \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u0432\u043a\u0430\u0437\u0430\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0456\u043e\u0434\u0443, \u041f\u041f\u041e \u0437\u0431\u0438\u0442\u043e/\u043f\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u043e 140 \u0411\u043f\u041b\u0410 (22 \u0456\u0437 \u043d\u0438\u0445 - \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u0456), \u0430 \u0442\u0430\u043a\u043e\u0436 6 S-8000 \u0411\u0430\u043d\u0434\u0435\u0440\u043e\u043b\u044c/\u0414\u0430\u043d\u044c-\u0422. \u0421\u0442\u0430", "snippet_en": "\ud83d\udcaa \u041f\u041f\u041e \u0437\u043d\u0435\u0448\u043a\u043e\u0434\u0438\u043b\u0430 140 \u0437\u0456 157 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0411\u043f\u041b\u0410 \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u